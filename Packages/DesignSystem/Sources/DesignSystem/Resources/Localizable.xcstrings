    "kerahatFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezent markiert im Bogen und bei den Zeiten: etwa 45 Min. nach Sonnenaufgang, 10 Min. vor Dhuhr und 45 Min. vor Maghrib. Nach hanafitischer Lehre wird dann nicht gebetet (das Asr des Tages ausgenommen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtly marked on the arc and in the times: about 45 min after sunrise, 10 min before Dhuhr and 45 min before Maghrib. In the Hanafi school no prayer is performed then (except that day’s Asr)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcados de forma discreta en el arco y en los horarios: unos 45 min tras la salida del sol, 10 min antes de Dhuhr y 45 min antes de Magrib. En la escuela hanafí no se reza en ellos (salvo el Asr de ese día)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemerde ve vakitlerde hafifçe işaretlenir: güneş doğduktan sonra yaklaşık 45 dk, öğleden önce 10 dk ve akşamdan önce 45 dk. Hanefî mezhebine göre bu vakitlerde namaz kılınmaz (o günün ikindisi hariç)."
          }
        }
      }
    },
