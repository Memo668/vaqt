        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অ্যাপটিতে মুক্ত সফটওয়্যার ও ফন্ট, একটি রেকর্ডিং এবং অন্যদের লেখা রয়েছে। লাইসেন্স ও বিজ্ঞপ্তিগুলো মূল ইংরেজিতে দেখানো হয়েছে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikacija sadrži slobodni softver i fontove, jedan snimak i tekstove drugih autora. Licence i napomene su u engleskom originalu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App enthält freie Software und Schriften, eine Aufnahme und Texte anderer. Lizenzen und Hinweise stehen im englischen Original."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app includes open-source software and fonts, a recording and texts by others. Licences and notices are shown in the original English."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app incluye software y tipografías libres, una grabación y textos de terceros. Las licencias y los avisos se muestran en su versión original en inglés."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "این برنامه نرم‌افزار و قلم‌های آزاد، یک ضبط صوتی و متن‌هایی از دیگران دارد. مجوزها و یادداشت‌ها به زبان اصلی انگلیسی آمده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’app contient des logiciels et des polices libres, un enregistrement et des textes de tiers. Les licences et mentions sont affichées dans leur version originale en anglais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikasi ini memuat perangkat lunak dan huruf bebas, sebuah rekaman, dan teks dari pihak lain. Lisensi dan keterangan ditampilkan dalam bahasa Inggris aslinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’app contiene software e caratteri liberi, una registrazione e testi di terzi. Licenze e note sono riportate nell’originale inglese."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikasi ini mengandungi perisian dan fon bebas, satu rakaman serta teks pihak lain. Lesen dan notis dipaparkan dalam bahasa Inggeris asal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De app bevat vrije software en lettertypen, een opname en teksten van anderen. Licenties en vermeldingen staan in het Engelse origineel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Приложение использует свободное ПО и шрифты, аудиозапись и тексты других авторов. Лицензии и примечания приведены в английском оригинале."
