        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اپنے iPhone کو آٹھ کے ہندسے کی شکل میں گھمائیں، یہاں تک کہ ریڈنگ ٹھہر جائے۔"
