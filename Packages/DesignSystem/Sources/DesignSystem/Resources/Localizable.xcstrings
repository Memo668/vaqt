    },
    "kerahatInfoP1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أوقات الكراهة ثلاث فترات قصيرة في اليوم تُكره فيها الصلاة – ليست محرّمة، لكن ينبغي اجتنابها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "মাকরুহ সময় হলো দিনের তিনটি ছোট সময়, যখন নামাজ পড়া মাকরুহ – হারাম নয়, তবে এড়িয়ে চলা উচিত।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mekruh vakti su tri kratka perioda u toku dana kada je klanjanje mekruh – nije haram, ali ga je bolje izbjegavati."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbotszeiten (Kerahat) sind drei kurze Zeitfenster am Tag, in denen man nicht beten soll. Das Gebet ist dann makrūh, also zu meiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makruh times are three short windows in the day when praying is makruh – not forbidden, but best avoided."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tiempos makruh son tres breves franjas del día en las que rezar es makruh – no está prohibido, pero es mejor evitarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اوقات مکروه سه بازه کوتاه در روز است که نماز خواندن در آن‌ها مکروه است – حرام نیست، اما بهتر است از آن پرهیز شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les heures makrouh sont trois courts moments de la journée où prier est makrouh – ce n’est pas interdit, mais il vaut mieux l’éviter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu makruh adalah tiga rentang waktu singkat dalam sehari ketika salat hukumnya makruh – tidak haram, tetapi sebaiknya dihindari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I momenti makruh sono tre brevi fasce della giornata in cui pregare è makruh – non è vietato, ma è meglio evitarlo."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu makruh ialah tiga tempoh singkat dalam sehari ketika solat adalah makruh – tidak haram, tetapi sebaiknya dielakkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Makroeh-tijden zijn drie korte momenten op de dag waarop bidden makroeh is – niet verboden, maar beter te vermijden."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Время макрух – это три коротких промежутка в течение дня, когда совершать намаз – макрух: это не запрещено, но этого лучше избегать."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kohët mekruh janë tri periudha të shkurtra gjatë ditës kur falja e namazit është mekruh – jo haram, por më mirë të shmanget."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerahat vakitleri, gün içinde namaz kılmanın mekruh olduğu üç kısa zaman dilimidir – haram değildir, ama kaçınılması gerekir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مکروہ اوقات دن کے تین مختصر وقفے ہیں جن میں نماز پڑھنا مکروہ ہے – حرام نہیں، لیکن ان سے بچنا چاہیے۔"
          }
        }
      }
    },
    "kerahatInfoP2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "السبب الوارد في الحديث أن الشمس كانت تُعبد في هذه الأوقات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "হাদিসে এর কারণ বলা হয়েছে, এই সময়গুলোতে সূর্যের উপাসনা করা হতো।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "U hadisu se kao razlog navodi da se u ta vremena obožavalo sunce."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Grund ist überliefert, dass zu diesen Zeiten die Sonne angebetet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reason given in the hadith is that the sun was worshipped at these times."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según el hadiz, el motivo es que en estos momentos se adoraba al sol."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دلیلی که در حدیث آمده این است که در این اوقات خورشید پرستیده می‌شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La raison donnée dans le hadith est qu’on adorait le soleil à ces moments-là."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alasan yang disebutkan dalam hadis adalah bahwa pada waktu-waktu tersebut matahari disembah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Secondo l’hadith, il motivo è che in questi momenti si adorava il sole."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sebab yang dinyatakan dalam hadis ialah matahari disembah pada waktu-waktu ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volgens de hadith is de reden dat de zon op deze tijden werd aanbeden."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В хадисе причиной названо то, что в это время поклонялись солнцу."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si arsye në hadith përmendet se në këto kohë adhurohej dielli."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivayete göre sebebi, bu vakitlerde güneşe tapılmasıdır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حدیث میں اس کی وجہ یہ بیان ہوئی ہے کہ ان اوقات میں سورج کی پرستش کی جاتی تھی۔"
          }
        }
      }
    },
