    "ob3Live" : {
      "comment" : "Argumente: 1 = app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قبل كل صلاة، يعرض %@ أيضًا عدًّا تنازليًا على شاشة القفل: النشاط المباشر. ويمكنك إيقافه في أي وقت من الإعدادات › النشاط المباشر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রতিটি নামাজের আগে %@ লক স্ক্রিনে একটি কাউন্টডাউনও দেখায়: লাইভ অ্যাক্টিভিটি। যেকোনো সময় সেটিংস › লাইভ অ্যাক্টিভিটি থেকে এটি বন্ধ করতে পারেন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prije svakog namaza %@ prikazuje i odbrojavanje na zaključanom ekranu: Aktivnost uživo. Možete je isključiti bilo kada u Postavkama › Aktivnost uživo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor jedem Gebet zeigt %@ außerdem einen Countdown auf dem Sperrbildschirm, die Live-Aktivität. Abschalten kannst du sie jederzeit unter Einstellungen › Live-Aktivität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before each prayer, %@ also shows a countdown on the Lock Screen: the Live Activity. You can turn it off any time in Settings › Live Activity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de cada oración, %@ también muestra una cuenta atrás en la pantalla bloqueada: la Actividad en directo. Puedes desactivarla cuando quieras en Ajustes › Actividad en directo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پیش از هر نماز، %@ یک شمارش معکوس هم روی صفحه قفل نشان می‌دهد: فعالیت زنده. هر زمان می‌توانید آن را از تنظیمات › فعالیت زنده خاموش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avant chaque prière, %@ affiche aussi un compte à rebours sur l’écran verrouillé : l’Activité en direct. Vous pouvez la désactiver à tout moment dans Réglages › Activité en direct."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sebelum setiap salat, %@ juga menampilkan hitung mundur di Layar Terkunci: Aktivitas Langsung. Anda dapat mematikannya kapan saja di Pengaturan › Aktivitas Langsung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prima di ogni preghiera, %@ mostra anche un conto alla rovescia sulla schermata di blocco: l’Attività in tempo reale. Puoi disattivarla quando vuoi in Impostazioni › Attività in tempo reale."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sebelum setiap solat, %@ turut memaparkan kiraan detik pada Skrin Kunci: Aktiviti Langsung. Anda boleh mematikannya bila-bila masa dalam Seting › Aktiviti Langsung."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vóór elk gebed toont %@ ook een aftelling op het toegangsscherm: de Live-activiteit. Je kunt die altijd uitzetten via Instellingen › Live-activiteit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перед каждым намазом %@ также показывает обратный отсчёт на экране блокировки – это Live Activity. Отключить её можно в любой момент в Настройках › Live Activity."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para çdo namazi, %@ shfaq edhe një numërim mbrapsht në ekranin e kyçjes: Aktiviteti live. Mund ta çaktivizoni kurdo te Cilësimet › Aktiviteti live."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ her namazdan önce kilit ekranında bir geri sayım da gösterir: Canlı Etkinlik. İstediğin zaman Ayarlar › Canlı Etkinlik bölümünden kapatabilirsin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ہر نماز سے پہلے %@ لاک اسکرین پر الٹی گنتی بھی دکھاتی ہے: لائیو ایکٹیویٹی۔ آپ اسے کسی بھی وقت سیٹنگز › لائیو ایکٹیویٹی میں بند کر سکتے ہیں۔"
          }
        }
      }
    },
    "ob3Title" : {
