    "ob3Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أذان أو تنبيه صامت أو لا شيء — لكل صلاة على حدة. ويمكنك تغيير ذلك في أي وقت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আজান, নীরব নোটিফিকেশন বা কিছুই না — প্রতিটি নামাজের জন্য আলাদা। যেকোনো সময় বদলানো যায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ezan, tiha obavijest ili ništa — za svaki namaz posebno. Promijenite kad god želite."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan, stille Mitteilung oder nichts – pro Gebet. Jederzeit änderbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan, silent alert or nothing — per prayer. Change it any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan, aviso silencioso o nada, para cada oración. Puedes cambiarlo cuando quieras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اذان، اعلان بی‌صدا یا هیچ — برای هر نماز جداگانه. هر زمان قابل تغییر است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adhan, alerte silencieuse ou rien — pour chaque prière. Modifiable à tout moment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Azan, notifikasi senyap, atau tidak sama sekali — per salat. Bisa diubah kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adhan, notifica silenziosa o niente — per ogni preghiera. Puoi cambiarlo quando vuoi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Azan, pemberitahuan senyap atau tiada — bagi setiap solat. Boleh ditukar bila-bila masa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adhaan, stille melding of niets — per gebed. Altijd te wijzigen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Азан, тихое уведомление или ничего — для каждого намаза. Можно изменить в любой момент."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ezan, njoftim pa tingull ose asgjë — për secilin namaz veç. Mund ta ndryshoni kurdo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezan, sessiz bildirim ya da hiçbiri – her namaz için ayrı. İstediğin zaman değiştir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اذان، خاموش اطلاع یا کچھ نہیں — ہر نماز کے لیے الگ۔ کسی بھی وقت تبدیل کریں۔"
          }
        }
      }
    },
