    "highLatNote" : {
      "comment" : "Argumente: 1 = city, 2 = rule.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "في الصيف لا يحلّ الظلام تمامًا ليلًا في %1$@. يُقدَّر وقتا الفجر والعشاء بقاعدة «%2$@»."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "গ্রীষ্মে %1$@ শহরে কখনো পুরোপুরি অন্ধকার হয় না। ফজর ও এশা “%2$@” নিয়মে অনুমান করা হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ljeti u gradu %1$@ nikada ne bude potpuno mrak. Sabah i jacija procjenjuju se prema pravilu „%2$@“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Sommer wird es in %1$@ nachts nicht ganz dunkel. Fadschr und Ischa werden mit der Regel „%2$@“ geschätzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In summer it never gets fully dark in %1$@. Fajr and Isha are estimated with the “%2$@” rule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En verano no llega a oscurecer del todo en %1$@. Fajr e Isha se estiman con la regla “%2$@”."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "در تابستان، شب‌ها در %1$@ کاملاً تاریک نمی‌شود. صبح و عشاء با قاعده «%2$@» تخمین زده می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En été, il ne fait jamais complètement nuit à %1$@. Le Fajr et l’Icha sont estimés avec la règle « %2$@ »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Di musim panas, langit di %1$@ tidak pernah benar-benar gelap. Subuh dan Isya diperkirakan dengan aturan “%2$@”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In estate a %1$@ non fa mai completamente buio. Fajr e Isha sono stimati con la regola “%2$@”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pada musim panas, langit di %1$@ tidak pernah benar-benar gelap. Subuh dan Isyak dianggarkan dengan peraturan “%2$@”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In de zomer wordt het in %1$@ ’s nachts nooit helemaal donker. Fajr en Isha worden geschat met de regel ‘%2$@’."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@: летом здесь не бывает полной темноты. Фаджр и Иша рассчитываются приблизительно по правилу «%2$@»."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Në verë në %1$@ nuk errësohet plotësisht natën. Sabahu dhe jacia vlerësohen sipas rregullit „%2$@“."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazın %1$@ şehrinde gece tam kararmaz. İmsak ve yatsı “%2$@” kuralıyla tahmin edilir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "گرمیوں میں %1$@ میں کبھی مکمل اندھیرا نہیں ہوتا۔ فجر اور عشاء کا اندازہ “%2$@” اصول سے لگایا جاتا ہے۔"
          }
        }
      }
    },
