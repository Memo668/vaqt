    "verse_2_45" : {
      "comment" : "Übersetzung von 2:45 aus `VERSES` im Prototyp: wörtlicher Ausschnitt einer veröffentlichten Übersetzung, „…“ steht für ausgelassene Teile des Verses (Spec § 11.1). Nicht umformulieren; Übersetzer und Quelle je Sprache in docs/THIRD-PARTY.md. Arabisch hat keine Übersetzung, der Vers steht darüber.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : ""
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ধৈর্য্যর সাথে সাহায্য প্রার্থনা কর নামাযের মাধ্যমে। …"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pomozite sebi strpljenjem i molitvom …"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Und sucht Hilfe in der Standhaftigkeit und im Gebet! …"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "And seek help through patience and prayer …"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busquen socorro en la paciencia y la oración. …"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "از شكيبايى و نماز يارى جوييد. …"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et cherchez secours dans l'endurance et la salât …"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dan mohonlah pertolongan (kepada Allah) dengan sabar dan salat. …"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cercate aiuto nella pazienza e nell'adorazione …"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dan mintalah pertolongan (kepada Allah) dengan jalan sabar dan mengerjakan sembahyang …"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neemt jullie toevlucht tot geduld en de salaat. …"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обратитесь за помощью к терпению и намазу. …"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kërkoni ndihmë (në të gjitha çështjet) me durim dhe me namaz …"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabır ve namaz ile Allah'tan yardım isteyin. …"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اور (رنج وتکلیف میں) صبر اور نماز سے مدد لیا کرو …"
          }
        }
      }
    },
    "verse_2_152" : {
      "comment" : "Übersetzung von 2:152 aus `VERSES` im Prototyp: wörtlicher Ausschnitt einer veröffentlichten Übersetzung, „…“ steht für ausgelassene Teile des Verses (Spec § 11.1). Nicht umformulieren; Übersetzer und Quelle je Sprache in docs/THIRD-PARTY.md. Arabisch hat keine Übersetzung, der Vers steht darüber.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : ""
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "সুতরাং তোমরা আমাকে স্মরণ কর, আমিও তোমাদের স্মরণ রাখবো …"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sjećajte se vi Mene, i Ja ću se vas sjetiti …"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedenkt Meiner, so gedenke Ich eurer. …"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So remember Me; I will remember you. …"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuérdenme que Yo los recordaré …"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پس مرا ياد كنيد، [تا] شما را ياد كنم …"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Souvenez-vous de Moi donc. Je vous récompenserai. …"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maka ingatlah kepada-Ku, Aku pun akan ingat kepadamu. …"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ricordatevi dunque di Me e Io Mi ricorderò di voi …"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oleh itu ingatlah kamu kepadaKu (dengan mematuhi hukum dan undang-undangKu), supaya Aku membalas kamu dengan kebaikan …"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gedenkt Mij, dan gedenk Ik jullie …"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поминайте Меня, и Я буду помнить о вас. …"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pra më kujtoni Mua, Unë ju kujtoj juve …"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öyle ise siz beni (ibadetle) anın ki ben de sizi anayım. …"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سو تم مجھے یاد کرو۔ میں تمہیں یاد کیا کروں گا۔ …"
          }
        }
      }
    },
    "verse_2_286" : {
      "comment" : "Übersetzung von 2:286 aus `VERSES` im Prototyp: wörtlicher Ausschnitt einer veröffentlichten Übersetzung, „…“ steht für ausgelassene Teile des Verses (Spec § 11.1). Nicht umformulieren; Übersetzer und Quelle je Sprache in docs/THIRD-PARTY.md. Arabisch hat keine Übersetzung, der Vers steht darüber.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : ""
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আল্লাহ কাউকে তার সাধ্যাতীত কোন কাজের ভার দেন না …"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allah nikoga ne opterećuje preko mogućnosti njegovih …"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allah erlegt keiner Seele mehr auf, als sie zu leisten vermag. …"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allah does not charge a soul except [with that within] its capacity. …"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dios no exige a nadie por encima de sus posibilidades …"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خداوند هيچ كس را جز به قدر توانايى‌اش تكليف نمى‌كند. …"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allah n'impose à aucune âme une charge supérieure à sa capacité. …"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allah tidak membebani seseorang melainkan sesuai dengan kesanggupannya. …"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allah non impone a nessun'anima al di là delle sue capacità. …"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allah tidak memberati seseorang melainkan apa yang terdaya olehnya. …"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "God legt niemand meer op dan hij kan dragen. …"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Аллах не возлагает на человека сверх его возможностей. …"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "All-llahu nuk ngarkon askë përtej mundësive të veta …"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allah her şahsı, ancak gücünün yettiği ölçüde mükellef kılar. …"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خدا کسی شخص کو اس کی طاقت سے زیادہ تکلیف نہیں دیتا۔ …"
          }
        }
      }
    },
    "verse_13_28" : {
      "comment" : "Übersetzung von 13:28 aus `VERSES` im Prototyp: wörtlicher Ausschnitt einer veröffentlichten Übersetzung, „…“ steht für ausgelassene Teile des Verses (Spec § 11.1). Nicht umformulieren; Übersetzer und Quelle je Sprache in docs/THIRD-PARTY.md. Arabisch hat keine Übersetzung, der Vers steht darüber.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : ""
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… জেনে রাখ, আল্লাহর যিকির দ্বারাই অন্তর সমূহ শান্তি পায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… a srca se doista, kad se Allah spomene, smiruju!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… Sicherlich, im Gedenken Allahs finden die Herzen Ruhe!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… Unquestionably, by the remembrance of Allah hearts are assured."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… ¿Acaso no es con el recuerdo de Dios que se sosiegan los corazones?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… آگاه باش كه با ياد خدا دلها آرامش مى‌يابد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… Certes, c'est par l'évocation d'Allah que les cœurs se tranquillisent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… Ingatlah, hanya dengan mengingat Allah hati menjadi tenteram."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… In verità, i cuori si rasserenano al Ricordo di Allah."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… Ketahuilah dengan \"zikrullah\" itu, tenang tenteramlah hati manusia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… zeker, door God te gedenken worden de harten gerustgesteld"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… Разве не поминанием Аллаха утешаются сердца?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… pra ta dini se me të përmendur All-llahun zemrat stabilizohen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… Bilesiniz ki, kalpler ancak Allah'ı anmakla huzur bulur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… اور سن رکھو کہ خدا کی یاد سے دل آرام پاتے ہیں"
          }
        }
      }
    },
    "verse_20_14" : {
      "comment" : "Übersetzung von 20:14 aus `VERSES` im Prototyp: wörtlicher Ausschnitt einer veröffentlichten Übersetzung, „…“ steht für ausgelassene Teile des Verses (Spec § 11.1). Nicht umformulieren; Übersetzer und Quelle je Sprache in docs/THIRD-PARTY.md. Arabisch hat keine Übersetzung, der Vers steht darüber.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : ""
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… এবং আমার স্মরণার্থে নামায কায়েম কর।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… i molitvu obavljaj – da bih ti uvijek na umu bio!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… und verrichte das Gebet zu Meinem Gedenken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… and establish prayer for My remembrance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… y haz la oración para recordarme."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… و به ياد من نماز برپا دار."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… et accomplis la Salât pour te souvenir de Moi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… dan laksanakanlah salat untuk mengingat Aku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… ed esegui l'orazione per ricordarti di Me."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… dan dirikanlah sembahyang untuk mengingati Daku."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… en verricht de salaat om Mij te gedenken."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… и совершай намаз, чтобы помнить обо Мне."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… dhe fal namazin për të më kujtuar Mua."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… beni anmak için namaz kıl."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "… اور میری یاد کے لئے نماز پڑھا کرو"
          }
        }
      }
    },
    "verse_94_5" : {
      "comment" : "Übersetzung von 94:5 aus `VERSES` im Prototyp: wörtlicher Ausschnitt einer veröffentlichten Übersetzung, „…“ steht für ausgelassene Teile des Verses (Spec § 11.1). Nicht umformulieren; Übersetzer und Quelle je Sprache in docs/THIRD-PARTY.md. Arabisch hat keine Übersetzung, der Vers steht darüber.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : ""
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "নিশ্চয় কষ্টের সাথে স্বস্তি রয়েছে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ta, zaista, s mukom je i last"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also gewiß, mit der Erschwernis ist Erleichterung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For indeed, with hardship [will be] ease."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luego de toda dificultad viene la facilidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پس [بدان كه‌] با دشوارى، آسانى است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A côté de la difficulté est, certes, une facilité!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maka sesungguhnya bersama kesulitan ada kemudahan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In verità per ogni difficoltà c'è una facilità."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oleh itu, maka (tetapkanlah kepercayaanmu) bahawa sesungguhnya tiap-tiap kesukaran disertai kemudahan"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Want met het moeilijke hangt het gemakkelijke samen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Воистину, за каждой тягостью наступает облегчение."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "E, pa dyshim se pas vështirësisë është lehtësimi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbette zorluğun yanında bir kolaylık vardır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ہاں ہاں مشکل کے ساتھ آسانی بھی ہے"
          }
        }
      }
    },
    "versePrev" : {
