          "stringUnit" : {
            "state" : "translated",
            "value" : "Hände, Mund, Nase, Gesicht, Arme, Kopf, Ohren und Füße waschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wash hands, mouth, nose, face, arms, head, ears and feet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lava manos, boca, nariz, cara, brazos, cabeza, orejas y pies."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دست‌ها، دهان، بینی، صورت و بازوها را بشویید، سر و گوش‌ها را مسح کنید و پاها را بشویید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lavez mains, bouche, nez, visage, bras, tête, oreilles et pieds."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Basuh tangan, mulut, hidung, wajah, lengan, kepala, telinga, dan kaki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lava mani, bocca, naso, viso, braccia, testa, orecchie e piedi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Basuh tangan, mulut, hidung, muka, lengan, kepala, telinga dan kaki."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was handen, mond, neus, gezicht, armen, hoofd, oren en voeten."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Омойте кисти рук, рот, нос, лицо, руки, голову, уши и ноги."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lani duart, gojën, hundën, fytyrën, krahët, kokën, veshët dhe këmbët."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller, ağız, burun, yüz, kollar, baş, kulaklar ve ayaklar."
          }
        },
        "ur" : {
