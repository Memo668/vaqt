    "kerahatFoot_hanbali" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وفق المذهب الحنبلي (الإعدادات › المذهب). الفترات تقريبية: 20 دقيقة بعد الشروق، و10 دقائق قبل الظهر، و20 دقيقة قبل الغروب."
