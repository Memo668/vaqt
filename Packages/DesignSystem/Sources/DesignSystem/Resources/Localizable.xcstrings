    "styleLiveFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يسري أيضًا على الأداة ذات القوس في الشاشة الرئيسية. والشفافية واحدة في جميع الخيارات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "হোম স্ক্রিনে বৃত্তচাপ-সহ উইজেটেও প্রযোজ্য। সব ধরনে স্বচ্ছতা একই থাকে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Važi i za widget s lukom na početnom ekranu. Prozirnost je ista u svim varijantama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt auch für das Widget mit dem Bogen auf dem Home-Bildschirm. Die Durchsichtigkeit ist bei allen Varianten gleich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also applies to the Home Screen widget with the arc. Transparency is the same in every variant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se aplica al widget con el arco en la pantalla de inicio. La transparencia es igual en todas las variantes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای ابزارک دارای کمان در صفحهٔ اصلی هم اعمال می‌شود. شفافیت در همه حالت‌ها یکسان است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S’applique aussi au widget avec l’arc sur l’écran d’accueil. La transparence est la même pour toutes les variantes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Juga berlaku untuk widget dengan busur di Layar Utama. Transparansinya sama di semua varian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vale anche per il widget con l’arco nella schermata Home. La trasparenza è uguale in tutte le varianti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Juga terpakai pada widget dengan lengkok di Skrin Utama. Ketelusan adalah sama bagi semua varian."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geldt ook voor de widget met de boog op het beginscherm. De transparantie is bij alle varianten gelijk."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Действует и для виджета с дугой на экране «Домой». Прозрачность во всех вариантах одинаковая."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vlen edhe për widgetin me hark në ekranin bazë. Tejdukshmëria është e njëjtë në të gjitha variantet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana ekrandaki yaylı widget için de geçerlidir. Saydamlık bütün seçeneklerde aynıdır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ہوم اسکرین پر قوس والے ویجٹ پر بھی لاگو ہوتا ہے۔ شفافیت سب اقسام میں ایک جیسی ہے۔"
          }
        }
      }
