    "licensesFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتضمن التطبيق برمجيات وخطوطًا حرة وتسجيلًا ونصوصًا لآخرين. التراخيص والإشعارات معروضة بلغتها الإنجليزية الأصلية."
