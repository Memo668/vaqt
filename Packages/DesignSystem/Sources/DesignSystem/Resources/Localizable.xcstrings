        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alarm zvoni svaki dan, čak i u nečujnom načinu rada i kada je uključen fokus – kao alarm u iOS-u."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wecker klingelt jeden Tag, auch im Stummmodus und bei Fokus – wie der Wecker von iOS."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The alarm rings every day, even in silent mode and with a Focus on – like the iOS alarm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La alarma suena todos los días, incluso en modo silencio y con un modo de concentración activado – como la alarma de iOS."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "زنگ هشدار هر روز به صدا درمی‌آید، حتی در حالت بی‌صدا و با تمرکز روشن – مانند زنگ هشدار iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’alarme sonne tous les jours, même en mode silencieux et avec un mode de concentration activé – comme l’alarme d’iOS."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alarm berbunyi setiap hari, bahkan dalam mode senyap dan saat Fokus aktif – seperti alarm iOS."
