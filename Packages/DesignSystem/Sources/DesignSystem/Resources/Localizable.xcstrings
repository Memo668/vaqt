    "perPrayerFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«صوت» يُشغّل النغمة المختارة، و«صامت» يعرض الإشعار فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“শব্দ” বেছে নেওয়া টোন বাজায়, “নীরব” শুধু নোটিফিকেশন দেখায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Zvuk“ reprodukuje odabrani ton, „Bez zvuka“ samo prikazuje obavijest."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ton“ spielt den gewählten Klang, „Lautlos“ zeigt nur die Mitteilung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sound” plays the selected tone, “Silent” only shows the notification."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sonido” reproduce el tono elegido; “Silencio” solo muestra la notificación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«صدا» آهنگ انتخاب‌شده را پخش می‌کند، «بی‌صدا» فقط اعلان را نشان می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« Son » joue la tonalité choisie, « Silencieux » affiche seulement la notification."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Suara” memutar nada yang dipilih, “Senyap” hanya menampilkan notifikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Suono” riproduce il tono selezionato, “Silenzioso” mostra solo la notifica."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Bunyi” memainkan nada yang dipilih, “Senyap” hanya menunjukkan pemberitahuan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‘Geluid’ speelt de gekozen toon af, ‘Stil’ toont alleen de melding."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Звук» воспроизводит выбранный сигнал, «Без звука» только показывает уведомление."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Me tingull“ luan tingullin e zgjedhur, „Pa tingull“ vetëm shfaq njoftimin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sesli” seçilen sesi çalar, “Sessiz” yalnızca bildirimi gösterir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“آواز” منتخب کردہ ٹون بجاتی ہے، “خاموش” صرف اطلاع دکھاتی ہے۔"
          }
        }
      }
    },
