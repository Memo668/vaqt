    "fajrVariantFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Aṣ-ṣalātu khairun mina n-naum“ – „Das Gebet ist besser als Schlaf“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes “As-salātu khayrun mina n-nawm” — “Prayer is better than sleep”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con “As-salatu jairun mina n-naum”: “La oración es mejor que el sueño”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Es-salâtü hayrun mine’n-nevm” – “Namaz uykudan hayırlıdır” ile."
          }
        }
      }
    },
