    "calibrateBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حرّك iPhone على شكل الرقم 8 حتى تستقر القراءة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "রিডিং স্থির না হওয়া পর্যন্ত আপনার iPhone আটের আকারে ঘোরান।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pomjerajte iPhone u obliku osmice dok se prikaz ne smiri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege dein iPhone in Form einer Acht, bis die Anzeige ruhig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move your iPhone in a figure-eight until the reading settles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el iPhone dibujando un ocho hasta que la lectura se estabilice."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhone خود را به شکل عدد 8 انگلیسی حرکت دهید تا عدد نمایش‌داده‌شده ثابت شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Déplacez votre iPhone en dessinant un huit jusqu’à ce que l’affichage se stabilise."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gerakkan iPhone Anda membentuk angka delapan hingga arahnya stabil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muovi l’iPhone disegnando un otto finché il valore non si stabilizza."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gerakkan iPhone anda membentuk angka lapan sehingga bacaan stabil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beweeg je iPhone in de vorm van een acht tot de weergave stabiel is."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Двигайте iPhone по траектории восьмёрки, пока показания не стабилизируются."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lëvizeni iPhone-in në formën e tetës derisa treguesi të qetësohet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gösterge sabitlenene kadar iPhone’unu sekiz çizerek hareket ettir."
