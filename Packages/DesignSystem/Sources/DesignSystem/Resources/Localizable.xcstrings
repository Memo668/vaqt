        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recita al-Fātiḥa. En las dos primeras rakʿas sigue otra sura."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fâtiha’yı oku. İlk iki rekâtta ardından bir sure daha okunur."
          }
        }
      }
    },
    "s_ruku" : {
      "extractionState" : "manual",
