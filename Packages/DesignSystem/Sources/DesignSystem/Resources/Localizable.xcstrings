    "tolLegend" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تمتد المنطقة المُعلَّمة 40° على كل جانب من القبلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "চিহ্নিত অংশটি কিবলার দুই পাশে 40° পর্যন্ত বিস্তৃত।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Označeno područje proteže se 40° sa svake strane kible."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der markierte Bereich reicht 40° zu jeder Seite der Qibla."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The marked area extends 40° either side of the Qibla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La zona marcada abarca 40° a cada lado de la Qibla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "محدوده علامت‌خورده از هر طرف قبله 40° امتداد دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La zone marquée s’étend sur 40° de chaque côté de la Qibla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Area yang ditandai mencakup 40° di kedua sisi kiblat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’area evidenziata si estende per 40° su ciascun lato della qibla."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kawasan bertanda meliputi 40° pada setiap sisi kiblat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het gemarkeerde gebied loopt 40° naar beide kanten van de Qibla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отмеченная область охватывает 40° по обе стороны от киблы."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zona e shënuar shtrihet 40° në secilën anë të kibles."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
