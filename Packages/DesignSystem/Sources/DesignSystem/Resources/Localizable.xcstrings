    "guideFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anleitung zeigt den üblichen Ablauf. Einzelheiten unterscheiden sich je nach Rechtsschule – lerne das Gebet am besten mit deiner Moschee."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This guide shows the common sequence. Details differ between schools of law – ideally learn the prayer with your mosque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta guía muestra la secuencia habitual. Los detalles varían según la escuela jurídica; lo mejor es aprender la oración en tu mezquita."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu rehber genel kılınışı gösterir. Ayrıntılar mezhebe göre değişir; namazı en iyi camindeki hocandan öğren."
          }
        }
      }
    },
