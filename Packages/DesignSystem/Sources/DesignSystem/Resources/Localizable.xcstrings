    "adjFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اضبط أوقاتًا بعينها لتوافق مسجدك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার মসজিদের সাথে মেলাতে আলাদা আলাদা সময় ঠিক করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prilagodite pojedine vakte svojoj džamiji."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe einzelne Zeiten an deine Moschee an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fine-tune individual times to match your mosque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta cada horario al de tu mezquita."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اوقات را یکی‌یکی با مسجد خود هماهنگ کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajustez certaines heures pour qu’elles correspondent à votre mosquée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sesuaikan waktu tertentu agar sama dengan masjid Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regola i singoli orari in base alla tua moschea."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laraskan waktu tertentu supaya sepadan dengan masjid anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pas afzonderlijke tijden aan je moskee aan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Подстройте отдельные времена под свою мечеть."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Përshtatni vaktet e veçanta sipas xhamisë suaj."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vakitleri camindeki vakitlere göre ince ayarla."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "انفرادی اوقات کو اپنی مسجد کے مطابق ٹھیک کریں۔"
          }
        }
      }
    },
