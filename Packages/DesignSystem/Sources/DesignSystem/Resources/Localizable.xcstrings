    "kerahatP1_hanbali" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أوقات الكراهة ثلاث فترات قصيرة في اليوم لا تُؤدّى فيها صلوات التطوّع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "মাকরুহ সময় হলো দিনের তিনটি ছোট সময়, যখন নফল নামাজ পড়া হয় না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mekruh vakti su tri kratka perioda u toku dana kada se ne klanjaju dobrovoljni namazi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbotszeiten (Kerahat) sind drei kurze Zeitfenster am Tag, in denen man keine freiwilligen Gebete verrichtet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makruh times are three short windows in the day without voluntary prayers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tiempos makruh son tres breves franjas del día en las que no se rezan oraciones voluntarias."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اوقات مکروه سه بازه کوتاه در روز است که در آن‌ها نماز نفل خوانده نمی‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les heures makrouh sont trois courts moments de la journée où l’on n’accomplit pas de prières facultatives."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu makruh adalah tiga rentang waktu singkat dalam sehari ketika salat sunah tidak dikerjakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I momenti makruh sono tre brevi fasce della giornata in cui non si compiono preghiere facoltative."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu makruh ialah tiga tempoh singkat dalam sehari ketika solat sunat tidak didirikan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Makroeh-tijden zijn drie korte momenten op de dag waarop geen vrijwillige gebeden worden verricht."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Время макрух – это три коротких промежутка в течение дня, когда не совершают добровольных намазов."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kohët mekruh janë tri periudha të shkurtra gjatë ditës kur nuk falen namaze vullnetare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerahat vakitleri, nafile namaz kılınmayan üç kısa zaman dilimidir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مکروہ اوقات دن کے تین مختصر وقفے ہیں جن میں نفل نمازیں نہیں پڑھی جاتیں۔"
          }
        }
      }
    },
    "kerahatP1_maliki" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أوقات الكراهة في المذهب المالكي فترتان قصيرتان في اليوم لا تُؤدّى فيهما صلوات التطوّع: عند الشروق وقبل الغروب. ولا يعدّ المذهب المالكي منها وقتَ منتصف النهار، حين تكون الشمس في كبد السماء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "মালিকি মাযহাব অনুযায়ী মাকরুহ সময় হলো দিনের দুটি ছোট সময়, যখন নফল নামাজ পড়া হয় না: সূর্যোদয়ের সময় এবং সূর্যাস্তের আগে। সূর্য যখন ঠিক মাথার ওপরে থাকে, সেই দুপুরকে মালিকি মাযহাব এর মধ্যে ধরে না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po malikijskom mezhebu mekruh vakti su dva kratka perioda u toku dana kada se ne klanjaju dobrovoljni namazi: pri izlasku sunca i prije zalaska sunca. Podne, kada je sunce najviše, malikijski mezheb ne ubraja među njih."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbotszeiten (Kerahat) sind nach malikitischer Lehre zwei kurze Zeitfenster am Tag, in denen man keine freiwilligen Gebete verrichtet: beim Sonnenaufgang und vor Sonnenuntergang. Den Mittag, wenn die Sonne am höchsten steht, zählt die malikitische Schule nicht dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "According to the Maliki school, makruh times are two short windows in the day without voluntary prayers: at sunrise and before sunset. The Maliki school does not count noon, when the sun is at its highest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según la escuela malikí, los tiempos makruh son dos breves franjas del día en las que no se rezan oraciones voluntarias: al amanecer y antes de la puesta del sol. La escuela malikí no incluye el mediodía, cuando el sol está en lo más alto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اوقات مکروه بر اساس مذهب مالکی دو بازه کوتاه در روز است که در آن‌ها نماز نفل خوانده نمی‌شود: هنگام طلوع آفتاب و پیش از غروب آفتاب. مذهب مالکی نیمروز را، وقتی خورشید در بالاترین نقطه است، جزو آن‌ها نمی‌شمارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Selon l’école malikite, les heures makrouh sont deux courts moments de la journée où l’on n’accomplit pas de prières facultatives : au lever du soleil et avant le coucher du soleil. L’école malikite n’y inclut pas midi, quand le soleil est au plus haut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menurut mazhab Maliki, waktu makruh adalah dua rentang waktu singkat dalam sehari ketika salat sunah tidak dikerjakan: saat matahari terbit dan sebelum matahari terbenam. Mazhab Maliki tidak memasukkan tengah hari, saat matahari berada di titik tertinggi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Secondo la scuola malikita, i momenti makruh sono due brevi fasce della giornata in cui non si compiono preghiere facoltative: all’alba e prima del tramonto. La scuola malikita non vi include il mezzogiorno, quando il sole è al punto più alto."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menurut mazhab Maliki, waktu makruh ialah dua tempoh singkat dalam sehari ketika solat sunat tidak didirikan: ketika matahari terbit dan sebelum matahari terbenam. Mazhab Maliki tidak memasukkan waktu tengah hari, ketika matahari berada di titik tertinggi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volgens de malikitische school zijn makroeh-tijden twee korte momenten op de dag waarop geen vrijwillige gebeden worden verricht: bij zonsopgang en vóór zonsondergang. Het middaguur, als de zon het hoogst staat, rekent de malikitische school er niet toe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "По маликитскому мазхабу время макрух – это два коротких промежутка в течение дня, когда не совершают добровольных намазов: при восходе и перед закатом. Полдень, когда солнце в зените, маликитский мазхаб к ним не относит."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sipas medhhebit maliki, kohët mekruh janë dy periudha të shkurtra gjatë ditës kur nuk falen namaze vullnetare: gjatë lindjes së diellit dhe para perëndimit të diellit. Mesditën, kur dielli është në pikën më të lartë, medhhebi maliki nuk e llogarit ndër to."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mâlikî mezhebine göre kerahat vakitleri, nafile namaz kılınmayan iki kısa zaman dilimidir: güneş doğarken ve güneş batmadan önce. Güneşin tam tepede olduğu öğle vaktini Mâlikî mezhebi bunlara saymaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مالکی مسلک کے مطابق مکروہ اوقات دن کے دو مختصر وقفے ہیں جن میں نفل نمازیں نہیں پڑھی جاتیں: طلوعِ آفتاب کے وقت اور غروبِ آفتاب سے پہلے۔ دوپہر کے وقت کو، جب سورج عین سر پر ہو، مالکی مسلک ان میں شمار نہیں کرتا۔"
          }
        }
      }
    },
    "kerahatP1_shafii" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أوقات الكراهة ثلاث فترات قصيرة في اليوم لا تُؤدّى فيها صلوات التطوّع. وفي المذهب الشافعي لا تسري فترة ما قبل الظهر يوم الجمعة؛ ويجعل المذهب لمكة المكرمة استثناءً آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "মাকরুহ সময় হলো দিনের তিনটি ছোট সময়, যখন নফল নামাজ পড়া হয় না। শাফেয়ি মাযহাব অনুযায়ী শুক্রবারে যোহরের আগের সময়টি প্রযোজ্য নয়; মক্কার জন্য এই মাযহাব আরও একটি ব্যতিক্রম রাখে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mekruh vakti su tri kratka perioda u toku dana kada se ne klanjaju dobrovoljni namazi. Po šafijskom mezhebu period prije podneva ne važi petkom; za Mekku ovaj mezheb pravi još jedan izuzetak."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbotszeiten (Kerahat) sind drei kurze Zeitfenster am Tag, in denen man keine freiwilligen Gebete verrichtet. Nach schafiitischer Lehre gilt das Fenster vor Dhuhr am Freitag nicht; für Mekka macht die Schule eine weitere Ausnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makruh times are three short windows in the day without voluntary prayers. According to the Shafi‘i school, the window before Dhuhr does not apply on Friday, and Mecca is a further exception."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tiempos makruh son tres breves franjas del día en las que no se rezan oraciones voluntarias. Según la escuela shafií, la franja antes de Dhuhr no se aplica los viernes; para La Meca, la escuela hace otra excepción."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اوقات مکروه سه بازه کوتاه در روز است که در آن‌ها نماز نفل خوانده نمی‌شود. بر اساس مذهب شافعی، بازه پیش از ظهر در روز جمعه اعمال نمی‌شود؛ این مذهب برای مکه استثنای دیگری هم قائل است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les heures makrouh sont trois courts moments de la journée où l’on n’accomplit pas de prières facultatives. Selon l’école chaféite, le moment avant le Dohr ne s’applique pas le vendredi ; pour La Mecque, l’école fait une autre exception."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu makruh adalah tiga rentang waktu singkat dalam sehari ketika salat sunah tidak dikerjakan. Menurut mazhab Syafi’i, rentang sebelum Dzuhur tidak berlaku pada hari Jumat; untuk Mekah, mazhab ini memberi satu pengecualian lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I momenti makruh sono tre brevi fasce della giornata in cui non si compiono preghiere facoltative. Secondo la scuola shafiita, la fascia prima di Dhuhr non vale il venerdì; per la Mecca la scuola fa un’altra eccezione."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu makruh ialah tiga tempoh singkat dalam sehari ketika solat sunat tidak didirikan. Menurut mazhab Syafi’i, tempoh sebelum Zohor tidak terpakai pada hari Jumaat; bagi Makkah, mazhab ini membuat satu lagi pengecualian."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Makroeh-tijden zijn drie korte momenten op de dag waarop geen vrijwillige gebeden worden verricht. Volgens de sjafiitische school geldt het moment vóór Dhuhr niet op vrijdag; voor Mekka maakt de school nog een uitzondering."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Время макрух – это три коротких промежутка в течение дня, когда не совершают добровольных намазов. По шафиитскому мазхабу промежуток перед Зухром в пятницу не действует; для Мекки этот мазхаб делает ещё одно исключение."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kohët mekruh janë tri periudha të shkurtra gjatë ditës kur nuk falen namaze vullnetare. Sipas medhhebit shafi’i, periudha para drekës nuk vlen të premten; për Mekën ky medhheb bën edhe një përjashtim tjetër."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerahat vakitleri, nafile namaz kılınmayan üç kısa zaman dilimidir. Şâfiî mezhebine göre öğleden önceki vakit cuma günü geçerli değildir; Mekke için de ayrı bir istisna vardır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مکروہ اوقات دن کے تین مختصر وقفے ہیں جن میں نفل نمازیں نہیں پڑھی جاتیں۔ شافعی مسلک کے مطابق جمعہ کے دن ظہر سے پہلے کا وقفہ لاگو نہیں ہوتا؛ مکہ کے لیے یہ مسلک ایک اور استثنا رکھتا ہے۔"
          }
        }
      }
    },
    "kerahatQadaHanafi" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "في المذهب الحنفي لا تقضي صلاةً فائتة في هذه الفترات الثلاث – وإنما تصلّي عصر اليوم نفسه قبل الغروب. وبعد صلاتي الفجر والعصر يجوز لك القضاء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "হানাফি মাযহাব অনুযায়ী এই তিনটি সময়ে ছুটে যাওয়া নামাজের কাযা আদায় করবেন না – শুধু সেদিনের আসর সূর্যাস্তের আগে তখনও পড়ে নেবেন। ফজর ও আসরের নামাজের পর কাযা আদায় করতে পারেন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po hanefijskom mezhebu propušteni namaz ne naklanjate u ova tri perioda – samo ikindiju istog dana još klanjate prije zalaska sunca. Nakon klanjanja sabaha i ikindije smijete naklanjati."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach hanafitischer Lehre holst du ein versäumtes Gebet nicht in diesen drei Zeitfenstern nach – nur das Asr desselben Tages betest du vor Sonnenuntergang noch. Nach dem Fadschr- und dem Asr-Gebet darfst du nachholen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "According to the Hanafi school, missed prayers are not made up in these three windows – only the same day’s Asr may still be prayed before sunset. Making up prayers after Fajr and Asr is permitted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según la escuela hanafí, no recuperas una oración perdida en estas tres franjas – solo el Asr del mismo día lo rezas todavía antes de la puesta del sol. Después de las oraciones del Fajr y del Asr sí puedes recuperarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بر اساس مذهب حنفی، نماز فوت‌شده را در این سه بازه قضا نمی‌کنید – فقط عصر همان روز را پیش از غروب آفتاب باز هم می‌خوانید. پس از نماز صبح و نماز عصر می‌توانید قضا کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Selon l’école hanafite, vous ne rattrapez pas de prière manquée pendant ces trois moments – seul l’Asr du jour même se prie encore avant le coucher du soleil. Après les prières du Fajr et de l’Asr, le rattrapage est permis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menurut mazhab Hanafi, Anda tidak mengqadha salat yang terlewat pada tiga rentang waktu ini – hanya Ashar hari itu yang masih Anda kerjakan sebelum matahari terbenam. Setelah salat Subuh dan Ashar, Anda boleh mengqadha."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Secondo la scuola hanafita, non recuperi una preghiera mancata in queste tre fasce – solo l’Asr dello stesso giorno lo preghi ancora prima del tramonto. Dopo le preghiere del Fajr e dell’Asr puoi recuperarla."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menurut mazhab Hanafi, anda tidak mengqada solat yang tertinggal dalam tiga tempoh ini – hanya Asar hari yang sama masih anda tunaikan sebelum matahari terbenam. Selepas solat Subuh dan Asar, anda boleh mengqada."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volgens de hanafitische school haal je een gemist gebed niet in tijdens deze drie momenten – alleen het Asr-gebed van dezelfde dag bid je nog vóór zonsondergang. Na het Fajr- en het Asr-gebed mag je het wel inhalen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "По ханафитскому мазхабу пропущенный намаз не восполняют в эти три промежутка – только Аср того же дня ещё совершают перед закатом. После намазов Фаджр и Аср восполнять можно."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sipas medhhebit hanefi, namazin e humbur nuk e falni kaza në këto tri periudha – vetëm ikindinë e së njëjtës ditë e falni ende para perëndimit të diellit. Pas namazit të sabahut dhe të ikindisë mund të falni kaza."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanefî mezhebine göre kaza namazı bu üç vakitte kılınmaz – yalnızca o günün ikindisi güneş batmadan önce kılınabilir. Sabah ve ikindi namazından sonra kaza kılmak caizdir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حنفی مسلک کے مطابق آپ چھوٹی ہوئی نماز کی قضا ان تین وقفوں میں نہیں کرتے – صرف اسی دن کی عصر آپ غروبِ آفتاب سے پہلے پھر بھی پڑھ لیتے ہیں۔ فجر اور عصر کی نماز کے بعد آپ قضا کر سکتے ہیں۔"
          }
        }
      }
    },
