    "kerahatAfterBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بعد صلاة الفجر حتى الشروق، وبعد صلاة العصر حتى الغروب، لا تُؤدّى صلوات التطوّع. وعلى هذا تتفق المذاهب الأربعة. ولأن هذه الأوقات تبدأ بصلاتك أنت، لا يعرضها التطبيق على القوس."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ফজরের নামাজের পর সূর্যোদয় পর্যন্ত এবং আসরের নামাজের পর সূর্যাস্ত পর্যন্ত নফল নামাজ পড়া হয় না। এ বিষয়ে চার মাযহাবই একমত। এই সময়গুলো আপনার নিজের নামাজ দিয়ে শুরু হয় বলে অ্যাপ এগুলো বৃত্তচাপে দেখায় না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nakon klanjanja sabaha do izlaska sunca i nakon klanjanja ikindije do zalaska sunca ne klanjaju se dobrovoljni namazi. U tome su saglasna sva četiri mezheba. Budući da ova vremena počinju vašim vlastitim namazom, aplikacija ih ne prikazuje na luku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Fadschr-Gebet bis zum Sonnenaufgang und nach dem Asr-Gebet bis zum Sonnenuntergang betet man keine freiwilligen Gebete. Darin sind sich alle vier Rechtsschulen einig. Weil diese Zeiten mit deinem eigenen Gebet beginnen, zeigt die App sie nicht im Bogen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the Fajr prayer until sunrise and after the Asr prayer until sunset, no voluntary prayers are performed. All four schools agree on this. Because these times begin with your own prayer, the app does not show them on the arc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de la oración del Fajr hasta la salida del sol y después de la oración del Asr hasta la puesta del sol no se rezan oraciones voluntarias. En esto coinciden las cuatro escuelas jurídicas. Como estos tiempos empiezan con tu propia oración, la app no los muestra en el arco."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پس از نماز صبح تا طلوع آفتاب و پس از نماز عصر تا غروب آفتاب نماز نفل خوانده نمی‌شود. هر چهار مذهب در این باره هم‌نظرند. چون این اوقات با نماز خود شما آغاز می‌شوند، برنامه آن‌ها را روی کمان نشان نمی‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après la prière du Fajr jusqu’au lever du soleil et après la prière de l’Asr jusqu’au coucher du soleil, on n’accomplit pas de prières facultatives. Les quatre écoles juridiques sont d’accord sur ce point. Comme ces moments commencent avec votre propre prière, l’app ne les affiche pas sur l’arc."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setelah salat Subuh hingga matahari terbit dan setelah salat Ashar hingga matahari terbenam, salat sunah tidak dikerjakan. Keempat mazhab sepakat dalam hal ini. Karena waktu ini dimulai dengan salat Anda sendiri, app tidak menampilkannya pada busur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dopo la preghiera del Fajr fino al sorgere del sole e dopo la preghiera dell’Asr fino al tramonto non si compiono preghiere facoltative. Su questo concordano tutte e quattro le scuole giuridiche. Poiché questi momenti iniziano con la tua preghiera, l’app non li mostra sull’arco."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Selepas solat Subuh hingga matahari terbit dan selepas solat Asar hingga matahari terbenam, solat sunat tidak didirikan. Keempat-empat mazhab bersepakat tentang perkara ini. Oleh sebab waktu ini bermula dengan solat anda sendiri, app tidak memaparkannya pada lengkung."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na het Fajr-gebed tot zonsopgang en na het Asr-gebed tot zonsondergang worden geen vrijwillige gebeden verricht. Daarover zijn alle vier de rechtsscholen het eens. Omdat deze tijden met je eigen gebed beginnen, toont de app ze niet op de boog."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "После намаза Фаджр до восхода и после намаза Аср до заката не совершают добровольных намазов. В этом согласны все четыре мазхаба. Поскольку это время начинается с вашего собственного намаза, приложение не показывает его на дуге."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pas namazit të sabahut deri në lindjen e diellit dhe pas namazit të ikindisë deri në perëndimin e diellit nuk falen namaze vullnetare. Për këtë pajtohen të katër medhhebet. Meqë këto kohë fillojnë me vetë namazin tuaj, aplikacioni nuk i shfaq në hark."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabah namazından sonra güneş doğana kadar ve ikindi namazından sonra güneş batana kadar nafile namaz kılınmaz. Dört mezhep bunda birleşir. Bu vakitler senin kıldığın namazla başladığı için uygulama onları yayda göstermez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فجر کی نماز کے بعد طلوعِ آفتاب تک اور عصر کی نماز کے بعد غروبِ آفتاب تک نفل نمازیں نہیں پڑھی جاتیں۔ اس پر چاروں مسالک متفق ہیں۔ چونکہ یہ اوقات آپ کی اپنی نماز سے شروع ہوتے ہیں، اس لیے ایپ انہیں قوس پر نہیں دکھاتی۔"
          }
        }
      }
    },
