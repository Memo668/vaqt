    "privacyBody2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا حساب، ولا إعلانات، ولا أدوات تحليل. تُحسب مواقيت الصلاة على هذا الجهاز. ولمعرفة اسم المكان والبحث عن المدن، يستعلم التطبيق من خرائط Apple — ولا يصلنا نحن شيء من ذلك أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কোনো অ্যাকাউন্ট নেই, বিজ্ঞাপন নেই, অ্যানালিটিক্স নেই। নামাজের সময় এই ডিভাইসেই হিসাব করা হয়। জায়গার নাম ও শহর খোঁজার জন্য অ্যাপটি Apple Maps-এর কাছে জানতে চায় — আমরা এর কিছুই কখনো পাই না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bez računa, bez reklama, bez analitike. Namaski vakti se računaju na ovom uređaju. Za naziv mjesta i pretragu gradova aplikacija pita Apple Karte — mi od toga nikada ništa ne dobijamo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, keine Werbung, keine Analyse-Tools. Die Gebetszeiten berechnet die App auf diesem Gerät. Für den Ortsnamen und die Stadtsuche fragt sie Apple Karten – wir selbst erhalten davon nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account, no ads, no analytics. Prayer times are calculated on this device. For the place name and city search the app asks Apple Maps – we never receive any of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuentas, sin anuncios, sin herramientas de análisis. Los horarios de oración se calculan en este dispositivo. Para el nombre del lugar y la búsqueda de ciudades, la app consulta Mapas de Apple; nosotros nunca recibimos nada de ello."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بدون حساب کاربری، بدون تبلیغات، بدون ابزار تحلیل. اوقات نماز روی این دستگاه محاسبه می‌شود. برای نام مکان و جستجوی شهر، برنامه از Apple Maps می‌پرسد — ما هرگز هیچ‌یک از این اطلاعات را دریافت نمی‌کنیم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun compte, aucune publicité, aucun outil d’analyse. Les heures de prière sont calculées sur cet appareil. Pour le nom du lieu et la recherche de ville, l’app interroge Plans d’Apple — nous n’en recevons jamais rien."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanpa akun, tanpa iklan, tanpa analitik. Jadwal salat dihitung di perangkat ini. Untuk nama tempat dan pencarian kota, app ini bertanya kepada Peta Apple — kami sendiri tidak pernah menerima informasi itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nessun account, nessuna pubblicità, nessuno strumento di analisi. Gli orari di preghiera vengono calcolati su questo dispositivo. Per il nome del luogo e la ricerca della città, l’app si rivolge a Mappe di Apple — noi non ne riceviamo mai nulla."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiada akaun, tiada iklan, tiada analitik. Waktu solat dikira pada peranti ini. Untuk nama tempat dan carian bandar, app ini bertanya kepada Peta Apple — kami sendiri tidak pernah menerima maklumat itu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geen account, geen reclame, geen analysetools. De gebedstijden worden op dit apparaat berekend. Voor de plaatsnaam en het zoeken naar een stad raadpleegt de app Apple Kaarten — wij ontvangen daar zelf nooit iets van."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Без учётной записи, без рекламы, без аналитики. Время намаза рассчитывается на этом устройстве. За названием места и для поиска города приложение обращается к Apple Картам — сами мы никогда ничего из этого не получаем."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pa llogari, pa reklama, pa analitikë. Vaktet e namazit llogariten në këtë pajisje. Për emrin e vendit dhe kërkimin e qytetit, aplikacioni pyet Hartat e Apple — ne vetë nuk marrim kurrë asgjë nga këto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap yok, reklam yok, analiz araçları yok. Namaz vakitleri bu cihazda hesaplanır. Yer adı ve şehir araması için Apple Haritalar’a sorulur – biz bunların hiçbirini almayız."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نہ اکاؤنٹ، نہ اشتہارات، نہ اینالیٹکس۔ اوقاتِ نماز کا حساب اس آلے پر ہوتا ہے۔ جگہ کے نام اور شہر کی تلاش کے لیے ایپ Apple Maps سے پوچھتی ہے — ہمیں اس میں سے کچھ بھی کبھی نہیں ملتا۔"
          }
        }
      }
    },
