        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "হাম্বলি মাযহাব অনুযায়ী (সেটিংস › মাযহাব)। সময়গুলো আনুমানিক: সূর্যোদয়ের পর 20 মিনিট, যোহরের আগে 10 মিনিট এবং সূর্যাস্তের আগে 20 মিনিট।"
