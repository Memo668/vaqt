        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zamjenjuje postojeće brojeve preostalih namaza. Godina se računa kao 365 dana, a mjesec kao 30."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt die offenen Zahlen. Ein Jahr zählt 365 Tage, ein Monat 30."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaces the open counts. A year counts as 365 days, a month as 30."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye los números pendientes. Un año cuenta 365 días, un mes 30."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعدادهای باقی‌مانده فعلی را جایگزین می‌کند. هر سال 365 روز و هر ماه 30 روز حساب می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remplace les nombres restants. Une année compte 365 jours, un mois 30."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menggantikan jumlah sisa. Satu tahun dihitung 365 hari, satu bulan 30 hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
