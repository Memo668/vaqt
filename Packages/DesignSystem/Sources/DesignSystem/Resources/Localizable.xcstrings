    "s_rukuD" : {
      "comment" : "TODO(review): Text der Anleitung – fachlich ungeprüft; vor dem App Store von einem Imam oder Gelehrten prüfen lassen (Spec § 6.14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ظهرك مستقيم، ويداك على ركبتيك. ثلاث مرات:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "পিঠ সোজা, হাত হাঁটুর ওপর। তিনবার:"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leđa ravna, šake na koljenima. Tri puta:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rücken gerade, Hände auf den Knien. Dreimal:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back straight, hands on your knees. Three times:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espalda recta, manos en las rodillas. Tres veces:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پشت صاف، دست‌ها روی زانوها. سه بار:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dos droit, mains sur les genoux. Trois fois :"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Punggung lurus, tangan di atas lutut. Tiga kali:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schiena dritta, mani sulle ginocchia. Tre volte:"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Belakang lurus, tangan di atas lutut. Tiga kali:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rug recht, handen op je knieën. Drie keer:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Спина прямая, руки на коленях. Трижды:"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Shpina drejt, duart mbi gjunjë. Tri herë:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırt düz, eller dizlerde. Üç kez:"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کمر سیدھی، ہاتھ گھٹنوں پر۔ تین بار:"
          }
        }
      }
    },
