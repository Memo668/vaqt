    "qadaApplyFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستبدل الأعداد المتبقية الحالية. تُحسب السنة 365 يومًا، والشهر 30 يومًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "বাকি সংখ্যাগুলো প্রতিস্থাপন করে। এক বছর 365 দিন, এক মাস 30 দিন ধরা হয়।"
