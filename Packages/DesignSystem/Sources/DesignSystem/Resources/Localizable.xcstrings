    "s_salamD" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopf nach rechts, dann nach links:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn your head to the right, then to the left:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la cabeza a la derecha y luego a la izquierda:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başını önce sağa, sonra sola çevir:"
          }
        }
