    "s_salamD" : {
      "comment" : "TODO(review): Text der Anleitung – fachlich ungeprüft; vor dem App Store von einem Imam oder Gelehrten prüfen lassen (Spec § 6.14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التفت برأسك إلى اليمين، ثم إلى اليسار:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "মাথা প্রথমে ডানে, তারপর বামে ফেরান:"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Okrenite glavu udesno, zatim ulijevo:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopf nach rechts, dann nach links:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn your head to the right, then to the left:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la cabeza a la derecha y luego a la izquierda:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سر را به راست، سپس به چپ بگردانید:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tournez la tête à droite, puis à gauche :"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Palingkan kepala ke kanan, lalu ke kiri:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gira la testa a destra, poi a sinistra:"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Palingkan kepala ke kanan, kemudian ke kiri:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Draai je hoofd naar rechts, dan naar links:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поверните голову вправо, затем влево:"
