    "qcLead" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كم من الوقت لم تصلِّ بانتظام؟ تكفي مدة تقريبية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কতদিন নিয়মিত নামাজ পড়েননি? আনুমানিক সময়কালই যথেষ্ট।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koliko dugo niste redovno klanjali? Dovoljan je okviran period."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange hast du nicht regelmäßig gebetet? Ein ungefährer Zeitraum reicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long did you not pray regularly? A rough period is enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuánto tiempo no rezaste con regularidad? Basta un periodo aproximado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "چه مدت به‌طور منظم نماز نخوانده‌اید؟ یک مدت تقریبی کافی است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pendant combien de temps n’avez-vous pas prié régulièrement ? Une période approximative suffit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Berapa lama Anda tidak salat secara teratur? Perkiraan kasar sudah cukup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per quanto tempo non hai pregato regolarmente? Basta un periodo approssimativo."
          }
        },
        "ms" : {
