    "disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مواقيت الصلاة حسابات، وقد تختلف ببضع دقائق عن مواقيت مسجدك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "নামাজের সময়গুলো হিসাবভিত্তিক এবং আপনার স্থানীয় মসজিদের সময় থেকে কয়েক মিনিট ভিন্ন হতে পারে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Namaski vakti su izračuni i mogu se za nekoliko minuta razlikovati od vakata u vašoj džamiji."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebetszeiten sind Berechnungen und können um einige Minuten von den Zeiten deiner Moschee abweichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prayer times are calculations and may differ by a few minutes from your local mosque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los horarios son cálculos y pueden diferir unos minutos de los de tu mezquita."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اوقات نماز حاصل محاسبه‌اند و ممکن است چند دقیقه با اوقات مسجد محل شما تفاوت داشته باشند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les heures de prière sont des calculs et peuvent différer de quelques minutes de celles de votre mosquée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jadwal salat merupakan hasil perhitungan dan dapat berbeda beberapa menit dari masjid setempat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gli orari di preghiera sono calcolati e possono differire di qualche minuto da quelli della tua moschea."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu solat ialah hasil pengiraan dan mungkin berbeza beberapa minit daripada masjid setempat anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gebedstijden zijn berekeningen en kunnen enkele minuten afwijken van de tijden van je moskee."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Время намаза рассчитывается и может отличаться на несколько минут от расписания вашей мечети."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaktet e namazit janë llogaritje dhe mund të ndryshojnë me disa minuta nga vaktet e xhamisë suaj."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namaz vakitleri hesaplamadır ve camindeki vakitlerden birkaç dakika farklı olabilir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اوقاتِ نماز حساب پر مبنی ہیں اور آپ کی مقامی مسجد کے اوقات سے چند منٹ مختلف ہو سکتے ہیں۔"
          }
        }
      }
    },
