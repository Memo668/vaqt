    "wkSujud2D" : {
      "comment" : "TODO(review): Entwurf für „Gebet Schritt für Schritt“ (Spec § 9.6) – fachlich ungeprüft wie die übrige Anleitung; vor dem App Store von einem Imam oder Gelehrten prüfen lassen (Spec § 6.14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اسجد مرة ثانية وقل ثلاث مرات مجددًا:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "দ্বিতীয়বার সিজদা করুন এবং আবার তিনবার বলুন:"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spustite se na sedždu drugi put i ponovo recite tri puta:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirf dich ein zweites Mal nieder und sprich wieder dreimal:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostrate a second time and again say three times:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postrate por segunda vez y di de nuevo tres veces:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بار دوم سجده کنید و باز سه بار بگویید:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prosternez-vous une seconde fois et dites de nouveau trois fois :"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sujud sekali lagi dan ucapkan kembali tiga kali:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prosternati una seconda volta e ripeti tre volte:"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sujud kali kedua dan sebut sekali lagi tiga kali:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ga een tweede keer in prosternatie en zeg weer drie keer:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Совершите второй земной поклон и снова скажите трижды:"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bini në sexhde për herë të dytë dhe thoni përsëri tri herë:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkinci kez secdeye var ve yine üç kez söyle:"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دوسری بار سجدہ کریں اور پھر تین بار کہیں:"
          }
        }
      }
    },
    "wkSujudD" : {
      "comment" : "TODO(review): Entwurf für „Gebet Schritt für Schritt“ (Spec § 9.6) – fachlich ungeprüft wie die übrige Anleitung; vor dem App Store von einem Imam oder Gelehrten prüfen lassen (Spec § 6.14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الجبهة والأنف واليدان والركبتان وأطراف القدمين على الأرض. قل ثلاث مرات:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কপাল, নাক, হাত, হাঁটু ও পায়ের আঙুল মাটিতে। তিনবার বলুন:"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Čelo, nos, šake, koljena i prsti nogu na tlu. Recite tri puta:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stirn, Nase, Hände, Knie und Zehen auf dem Boden. Sprich dreimal:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forehead, nose, hands, knees and toes on the ground. Say three times:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frente, nariz, manos, rodillas y dedos de los pies en el suelo. Di tres veces:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پیشانی، بینی، دست‌ها، زانوها و انگشتان پا روی زمین. سه بار بگویید:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Front, nez, mains, genoux et orteils au sol. Dites trois fois :"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dahi, hidung, kedua tangan, lutut, dan jari kaki menempel di lantai. Ucapkan tiga kali:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fronte, naso, mani, ginocchia e dita dei piedi a terra. Di’ tre volte:"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dahi, hidung, tangan, lutut dan jari kaki di atas lantai. Sebut tiga kali:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voorhoofd, neus, handen, knieën en tenen op de grond. Zeg drie keer:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Лоб, нос, руки, колени и пальцы ног на полу. Скажите трижды:"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Balli, hunda, duart, gjunjët dhe gishtat e këmbëve në tokë. Thoni tri herë:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alın, burun, eller, dizler ve ayak parmakları yerde. Üç kez söyle:"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پیشانی، ناک، ہاتھ، گھٹنے اور پاؤں کی انگلیاں زمین پر۔ تین بار کہیں:"
          }
        }
      }
    },
