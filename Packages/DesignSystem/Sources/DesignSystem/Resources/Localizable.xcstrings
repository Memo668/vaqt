        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Будильник звонит каждый день, даже в бесшумном режиме и при включённом фокусировании – как будильник iOS."
          }
        },
        "sq" : {
          "stringUnit" : {
