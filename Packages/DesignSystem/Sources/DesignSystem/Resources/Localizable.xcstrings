    "s_qiyamD" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies al-Fātiha. In den ersten zwei Rakʿas folgt eine weitere Sure."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recite al-Fātiḥa. In the first two rakʿahs another sūrah follows."
