    "soundSystemFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تختار هذه النغمة في إعدادات iOS ضمن «الأصوات والحس اللمسي». ولا يستطيع التطبيق أن يعرض نغمات Apple للاختيار بنفسه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কোন টোনটি বাজবে, তা আপনি iOS সেটিংসের “সাউন্ড ও হ্যাপটিক্স” থেকে বেছে নেন। কোনো অ্যাপ নিজে Apple-এর টোনগুলো বেছে নেওয়ার জন্য দিতে পারে না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koji je to zvuk, birate u postavkama iOS-a pod „Zvukovi i haptika“. Aplikacija ne može sama ponuditi Appleove tonove za odabir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcher Ton das ist, wählst du in den iOS-Einstellungen unter „Töne & Haptik“. Die Töne von Apple kann eine App nicht selbst zur Auswahl anbieten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You choose which sound this is in iOS Settings under “Sounds & Haptics”. An app cannot offer Apple’s tones itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tono concreto lo eliges en Ajustes de iOS, en “Sonidos y vibraciones”. Una app no puede ofrecer por sí misma los tonos de Apple para elegir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اینکه این کدام صدا باشد را در تنظیمات iOS، در بخش «صداها و بازخورد لمسی» انتخاب می‌کنید. یک برنامه نمی‌تواند صداهای Apple را خودش برای انتخاب عرضه کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous choisissez ce son dans les Réglages d’iOS, sous « Sons et vibrations ». Une app ne peut pas proposer elle-même le choix des sons d’Apple."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nada yang dipakai Anda pilih di Pengaturan iOS, pada “Suara & Haptik”. Sebuah app tidak dapat menawarkan sendiri nada Apple untuk dipilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il suono preciso lo scegli nelle Impostazioni di iOS, in “Suoni e feedback aptico”. Un’app non può offrire da sola la scelta dei suoni di Apple."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anda memilih bunyi ini dalam Seting iOS di bawah “Bunyi & Haptik”. Sesebuah app tidak boleh menawarkan sendiri bunyi Apple untuk dipilih."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Welk geluid dat is, kies je in de iOS-instellingen bij ‘Geluiden en voelbare feedback’. Een app kan de geluiden van Apple niet zelf ter keuze aanbieden."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Какой это звук, вы выбираете в Настройках iOS в разделе «Звуки, тактильные сигналы». Приложение не может само предложить звуки Apple на выбор."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tingullin e zgjidhni te Cilësimet e iOS, nën „Sounds & Haptics“. Një aplikacion nuk mund t’i ofrojë vetë tingujt e Apple-it për zgjedhje."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hangi ses olduğunu iOS Ayarları’ndan seçersin. Apple’ın seslerini bir uygulama kendisi seçenek olarak sunamaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "یہ کون سی ٹون ہو، یہ آپ iOS سیٹنگز میں “آوازیں اور ہیپٹکس” کے تحت چنتے ہیں۔ کوئی ایپ Apple کی ٹونز خود انتخاب کے لیے پیش نہیں کر سکتی۔"
          }
        }
      }
    },
