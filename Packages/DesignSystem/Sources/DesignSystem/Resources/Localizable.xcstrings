    "repeatNote" : {
      "comment" : "TODO(review): Text der Anleitung – fachlich ungeprüft; vor dem App Store von einem Imam oder Gelehrten prüfen lassen (Spec § 6.14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "في كل ركعة إضافية كرّر الخطوات 2–5."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রতিটি পরবর্তী রাকাতের জন্য ধাপ 2–5 আবার করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za svaki sljedeći rekat ponovite korake 2–5."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für jede weitere Rakʿa wiederholst du die Schritte 2–5."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For each further rakʿah, repeat steps 2–5."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cada rakʿa siguiente, repite los pasos 2–5."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای هر رکعت بعدی، مراحل 2–5 را تکرار کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour chaque rakʿa suivante, répétez les étapes 2–5."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
