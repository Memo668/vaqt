    "supportSoonBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ستتوفر إمكانية التبرع مع أحد التحديثات القادمة. وحتى ذلك الحين، تساعدنا توصيتك بالتطبيق بالفعل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অনুদানের সুবিধা আসবে পরবর্তী কোনো একটি আপডেটে। ততদিন অ্যাপটি অন্যদের কাছে সুপারিশ করলেও সাহায্য হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mogućnost doniranja stiže s jednim od sljedećih ažuriranja. Do tada već pomaže ako preporučite aplikaciju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Möglichkeit zu spenden kommt mit einem der nächsten Updates. Bis dahin hilft es schon, wenn du die App weiterempfiehlst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The option to donate arrives with one of the next updates. Until then, recommending the app already helps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La opción de donar llegará con una de las próximas actualizaciones. Mientras tanto, recomendar la app ya ayuda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "امکان کمک مالی با یکی از به‌روزرسانی‌های آینده می‌آید. تا آن زمان، معرفی برنامه به دیگران هم کمک می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La possibilité de faire un don arrivera avec l’une des prochaines mises à jour. D’ici là, recommander l’app nous aide déjà."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opsi donasi akan hadir di salah satu pembaruan berikutnya. Sementara itu, merekomendasikan app ini pun sudah membantu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La possibilità di donare arriverà con uno dei prossimi aggiornamenti. Nel frattempo, consigliare l’app è già un aiuto."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilihan untuk menderma akan tiba dalam salah satu kemas kini akan datang. Sementara itu, mengesyorkan app ini pun sudah membantu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De mogelijkheid om te doneren komt met een van de volgende updates. Tot die tijd helpt het al als je de app aanbeveelt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Возможность пожертвовать появится в одном из следующих обновлений. А пока вы уже помогаете, когда рекомендуете приложение."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mundësia për të dhuruar vjen me një nga përditësimet e ardhshme. Deri atëherë, ndihmon edhe nëse e rekomandoni aplikacionin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağış seçeneği sonraki güncellemelerden biriyle gelecek. O zamana kadar uygulamayı tavsiye etmen de çok yardımcı olur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عطیہ دینے کا آپشن اگلی اپ ڈیٹس میں سے کسی ایک کے ساتھ آئے گا۔ تب تک ایپ کی سفارش کرنا بھی مدد ہے۔"
          }
        }
      }
