    "ob2Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحسب المواقيت على جهازك مباشرةً. لا يُرسَل موقعك إلى أي جهة سوى خرائط Apple، التي توفّر اسم المكان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "সময়গুলো সরাসরি আপনার ডিভাইসেই হিসাব করা হয়। আপনার অবস্থান কেবল Apple Maps-এর কাছে যায়, যা জায়গার নাম জানায় — আর কারও কাছে নয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vakti se računaju direktno na vašem uređaju. Vaša lokacija se ne šalje nikome osim aplikaciji Apple Karte, koja daje naziv mjesta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeiten werden direkt auf deinem Gerät berechnet. Dein Standort geht an niemanden außer Apple Karten, das den Ortsnamen liefert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times are calculated right on your device. Your location goes to no one except Apple Maps, which provides the place name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los horarios se calculan directamente en tu dispositivo. Tu ubicación no se envía a nadie, salvo a Mapas de Apple, que proporciona el nombre del lugar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اوقات مستقیماً روی دستگاه شما محاسبه می‌شود. موقعیت شما جز به Apple Maps، که نام مکان را می‌دهد، به هیچ‌کس فرستاده نمی‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les heures sont calculées directement sur votre appareil. Votre position n’est transmise à personne, sauf à Plans d’Apple, qui fournit le nom du lieu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu salat dihitung langsung di perangkat Anda. Lokasi Anda tidak dikirim ke siapa pun selain Peta Apple, yang menyediakan nama tempat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gli orari vengono calcolati direttamente sul tuo dispositivo. La tua posizione non viene inviata a nessuno tranne che a Mappe di Apple, che fornisce il nome del luogo."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu solat dikira terus pada peranti anda. Lokasi anda tidak dihantar kepada sesiapa kecuali Peta Apple, yang memberikan nama tempat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De tijden worden direct op je apparaat berekend. Je locatie gaat naar niemand behalve Apple Kaarten, die de plaatsnaam levert."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Время рассчитывается прямо на вашем устройстве. Ваша геопозиция не передаётся никому, кроме Apple Карт, которые сообщают название места."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaktet llogariten drejtpërdrejt në pajisjen tuaj. Vendndodhja juaj nuk i dërgohet askujt përveç Hartave të Apple, të cilat japin emrin e vendit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vakitler doğrudan cihazında hesaplanır. Konumun, yer adını veren Apple Haritalar dışında kimseye gönderilmez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اوقات کا حساب براہِ راست آپ کے آلے پر ہوتا ہے۔ آپ کا مقام جگہ کا نام بتانے والے Apple Maps کے سوا کسی کو نہیں بھیجا جاتا۔"
          }
        }
      }
    },
