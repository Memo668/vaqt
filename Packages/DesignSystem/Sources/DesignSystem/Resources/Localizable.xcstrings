    "s_takbirD" : {
      "comment" : "TODO(review): Text der Anleitung – fachlich ungeprüft; vor dem App Store von einem Imam oder Gelehrten prüfen lassen (Spec § 6.14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ارفع يديك وقل – وبها تبدأ الصلاة:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "হাত তুলুন এবং বলুন – এর মাধ্যমে নামাজ শুরু হয়:"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podignite ruke i recite – time počinje namaz:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebe die Hände und sage – damit beginnt das Gebet:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise your hands and say – this begins the prayer:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levanta las manos y di; así empieza la oración:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دست‌ها را بالا ببرید و بگویید – با این، نماز آغاز می‌شود:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Levez les mains et dites – c’est ainsi que commence la prière :"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Angkat kedua tangan dan ucapkan – dengan ini salat dimulai:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alza le mani e di’ – così inizia la preghiera:"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Angkat kedua-dua tangan dan sebut – dengan ini solat bermula:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hef je handen en zeg – hiermee begint het gebed:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поднимите руки и скажите – так начинается намаз:"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ngrini duart dhe thoni – kështu fillon namazi:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellerini kaldır ve söyle – namaz böyle başlar:"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ہاتھ اٹھائیں اور کہیں – اسی سے نماز شروع ہوتی ہے:"
          }
        }
      }
    },
