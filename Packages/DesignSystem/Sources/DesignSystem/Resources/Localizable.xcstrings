    "wkTashFirstD" : {
      "comment" : "TODO(review): Entwurf für „Gebet Schritt für Schritt“ (Spec § 9.6) – fachlich ungeprüft wie die übrige Anleitung; vor dem App Store von einem Imam oder Gelehrten prüfen lassen (Spec § 6.14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اقرأ التحيات، ثم قم إلى الركعة الثالثة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আত্তাহিয়্যাতু পড়ুন, তারপর তৃতীয় রাকাতের জন্য দাঁড়ান।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proučite at-Taḥiyyāt, a zatim ustanite na 3. rekat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies at-Tahiyyāt, dann steh zur 3. Rakʿa auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recite at-Taḥiyyāt, then stand up for the 3rd rakʿah."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recita at-Taḥiyyāt y luego levántate para la 3.ª rakʿa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التحیات را بخوانید، سپس برای رکعت سوم برخیزید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Récitez at-Taḥiyyāt, puis levez-vous pour la 3e rakʿa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baca at-Tahiyyat, lalu berdiri untuk rakaat ke-3."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recita at-Taḥiyyāt, poi alzati per la 3ª rakʿa."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baca at-Tahiyyat, kemudian bangun untuk rakaat ketiga."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reciteer at-Taḥiyyāt en sta dan op voor de 3e rakʿa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Прочитайте ат-Тахият, затем встаньте для 3-го ракаата."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lexoni at-Taḥiyyāt, pastaj ngrihuni për rekatin e 3-të."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ettehiyyatü’yü oku, sonra 3. rekâta kalk."
          }
        },
        "ur" : {
