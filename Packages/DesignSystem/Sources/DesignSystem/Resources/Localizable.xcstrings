    "liveActFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عدّ تنازلي للصلاة التالية على شاشة القفل وفي Dynamic Island. ينتهي بعد 15 دقيقة من دخول وقت الصلاة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "লক স্ক্রিনে ও Dynamic Island-এ পরবর্তী নামাজ পর্যন্ত কাউন্টডাউন। নামাজের সময় শুরু হওয়ার 15 মিনিট পর শেষ হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odbrojavanje do sljedećeg namaza na zaključanom ekranu i u Dynamic Islandu. Završava 15 minuta nakon nastupanja vakta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Countdown zum nächsten Gebet auf dem Sperrbildschirm und in der Dynamic Island. Endet 15 Minuten nach Gebetsbeginn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Countdown to the next prayer on the Lock Screen and in the Dynamic Island. Ends 15 minutes after the prayer begins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta atrás hasta la próxima oración en la pantalla bloqueada y en la Dynamic Island. Termina 15 minutos después del inicio de la oración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "شمارش معکوس تا نماز بعدی روی صفحه قفل و در Dynamic Island. 15 دقیقه پس از آغاز نماز پایان می‌یابد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compte à rebours jusqu’à la prochaine prière sur l’écran verrouillé et dans la Dynamic Island. Se termine 15 minutes après le début de la prière."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hitung mundur ke salat berikutnya di Layar Terkunci dan di Dynamic Island. Berakhir 15 menit setelah waktu salat masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conto alla rovescia per la prossima preghiera sulla schermata di blocco e nella Dynamic Island. Termina 15 minuti dopo l’inizio della preghiera."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kiraan detik ke solat seterusnya pada Skrin Kunci dan dalam Dynamic Island. Tamat 15 minit selepas waktu solat masuk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aftellen tot het volgende gebed op het toegangsscherm en in het Dynamic Island. Stopt 15 minuten nadat het gebed is begonnen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обратный отсчёт до следующего намаза на экране блокировки и в Dynamic Island. Завершается через 15 минут после начала намаза."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Numërim mbrapsht deri te namazi i radhës në ekranin e kyçjes dhe në Dynamic Island. Përfundon 15 minuta pas hyrjes së vaktit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonraki namaza geri sayım kilit ekranında ve Dynamic Island’da görünür. Vakit girdikten 15 dakika sonra sona erer."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لاک اسکرین اور Dynamic Island میں اگلی نماز تک الٹی گنتی۔ نماز کا وقت شروع ہونے کے 15 منٹ بعد ختم ہو جاتی ہے۔"
          }
        }
      }
