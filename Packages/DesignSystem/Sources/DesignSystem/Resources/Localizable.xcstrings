    "noTimes" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتعذّر حساب مواقيت الصلاة لهذا الموقع اليوم، لأن الشمس لا تشرق أو لا تغرب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আজ এই স্থানের জন্য নামাজের সময় হিসাব করা যাচ্ছে না, কারণ সূর্য ওঠে না বা অস্ত যায় না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za ovu lokaciju danas se ne mogu izračunati namaski vakti jer sunce ne izlazi ili ne zalazi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Ort lassen sich heute keine Gebetszeiten berechnen, weil die Sonne nicht auf- oder untergeht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prayer times can’t be calculated for this location today because the sun doesn’t rise or set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy no se pueden calcular los horarios para este lugar porque el sol no sale o no se pone."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "امروز برای این مکان نمی‌توان اوقات نماز را محاسبه کرد، چون خورشید طلوع یا غروب نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les heures de prière ne peuvent pas être calculées aujourd’hui pour ce lieu, car le soleil ne se lève pas ou ne se couche pas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jadwal salat untuk lokasi ini tidak dapat dihitung hari ini karena matahari tidak terbit atau tidak terbenam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oggi non è possibile calcolare gli orari di preghiera per questo luogo perché il sole non sorge o non tramonta."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu solat untuk lokasi ini tidak dapat dikira hari ini kerana matahari tidak terbit atau tidak terbenam."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voor deze locatie kunnen vandaag geen gebedstijden worden berekend, omdat de zon niet op- of ondergaat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сегодня для этого места невозможно рассчитать время намаза, так как солнце не восходит или не заходит."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Për këtë vendndodhje sot nuk mund të llogariten vaktet e namazit, sepse dielli nuk lind ose nuk perëndon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu konum için bugün namaz vakitleri hesaplanamıyor, çünkü güneş doğmuyor veya batmıyor."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "آج اس مقام کے لیے اوقاتِ نماز کا حساب نہیں لگایا جا سکتا کیونکہ سورج طلوع یا غروب نہیں ہوتا۔"
          }
        }
      }
    },
