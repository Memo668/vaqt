    "s_rukuD" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rücken gerade, Hände auf den Knien. Dreimal:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back straight, hands on your knees. Three times:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espalda recta, manos en las rodillas. Tres veces:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırt düz, eller dizlerde. Üç kez:"
          }
        }
      }
    },
    "s_salam" : {
      "extractionState" : "manual",
      "localizations" : {
