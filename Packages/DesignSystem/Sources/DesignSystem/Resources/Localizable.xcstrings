    "kerahatFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مُعلَّمة على القوس، وتظهر أوقاتها بجانب مواقيت الصلاة: نحو 45 دقيقة بعد الشروق، و10 دقائق قبل الظهر، و45 دقيقة قبل المغرب. وفي المذهب الحنفي لا تُؤدّى فيها صلاة (إلا عصر ذلك اليوم)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "বৃত্তচাপে চিহ্নিত, আর সময়গুলো নামাজের সময়ের পাশে দেখানো হয়: সূর্যোদয়ের প্রায় 45 মিনিট পর, যোহরের 10 মিনিট আগে এবং মাগরিবের 45 মিনিট আগে। হানাফি মাযহাবে তখন কোনো নামাজ পড়া হয় না (সেদিনের আসর ছাড়া)।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Označeni su na luku, a njihova vremena stoje uz namaske vakte: oko 45 min nakon izlaska sunca, 10 min prije podneva i 45 min prije akšama. Po hanefijskom mezhebu tada se ne klanja (osim ikindije tog dana)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Bogen eingezeichnet, die Uhrzeiten stehen bei den Zeiten: etwa 45 Min. nach Sonnenaufgang, 10 Min. vor Dhuhr und 45 Min. vor Maghrib. Nach hanafitischer Lehre wird dann nicht gebetet (das Asr des Tages ausgenommen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marked on the arc, with their times next to the prayer times: about 45 min after sunrise, 10 min before Dhuhr and 45 min before Maghrib. In the Hanafi school no prayer is performed then (except that day’s Asr)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcados en el arco, con su hora junto a los horarios: unos 45 min tras la salida del sol, 10 min antes de Dhuhr y 45 min antes de Magrib. En la escuela hanafí no se reza en ellos (salvo el Asr de ese día)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "روی کمان علامت‌گذاری شده‌اند و ساعت آن‌ها کنار اوقات نماز آمده است: حدود 45 دقیقه پس از طلوع آفتاب، 10 دقیقه پیش از ظهر و 45 دقیقه پیش از مغرب. در مذهب حنفی در این اوقات نماز خوانده نمی‌شود (به‌جز عصر همان روز)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indiquées sur l’arc, avec leurs horaires à côté des heures de prière : environ 45 min après le lever du soleil, 10 min avant le Dohr et 45 min avant le Maghreb. Dans l’école hanafite, on ne prie pas pendant ces moments (sauf l’Asr du jour)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ditandai pada busur, dengan jamnya di samping waktu salat: sekitar 45 mnt setelah matahari terbit, 10 mnt sebelum Dzuhur, dan 45 mnt sebelum Maghrib. Dalam mazhab Hanafi, tidak ada salat yang dikerjakan pada waktu tersebut (kecuali Ashar hari itu)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Segnati sull’arco, con gli orari accanto agli orari di preghiera: circa 45 min dopo l’alba, 10 min prima di Dhuhr e 45 min prima di Maghrib. Nella scuola hanafita in questi momenti non si prega (tranne l’Asr del giorno)."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ditanda pada lengkung, dengan waktunya di sebelah waktu solat: kira-kira 45 min selepas matahari terbit, 10 min sebelum Zohor dan 45 min sebelum Maghrib. Dalam mazhab Hanafi, tiada solat didirikan pada waktu itu (kecuali Asar hari tersebut)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aangegeven op de boog, met de tijden bij de gebedstijden: ongeveer 45 min na zonsopgang, 10 min vóór Dhuhr en 45 min vóór Maghrib. Volgens de hanafitische school wordt er dan niet gebeden (behalve het Asr-gebed van die dag)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отмечено на дуге, время указано рядом со временем намазов: примерно 45 мин после восхода, 10 мин до Зухра и 45 мин до Магриба. В ханафитском мазхабе в это время намаз не совершают (кроме Асра того же дня)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Shënohen në hark, me oraret pranë vakteve: rreth 45 min pas lindjes së diellit, 10 min para drekës dhe 45 min para akshamit. Sipas medhhebit hanefi atëherë nuk falet namaz (përveç ikindisë së asaj dite)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemerde işaretlenir, saatleri vakitlerin yanında yazar: güneş doğduktan sonra yaklaşık 45 dk, öğleden önce 10 dk ve akşamdan önce 45 dk. Hanefî mezhebine göre bu vakitlerde namaz kılınmaz (o günün ikindisi hariç)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قوس پر نشان زد، اور ان کے اوقات نماز کے اوقات کے ساتھ درج ہیں: طلوعِ آفتاب کے تقریباً 45 منٹ بعد، ظہر سے 10 منٹ پہلے اور مغرب سے 45 منٹ پہلے۔ حنفی مسلک میں ان اوقات میں کوئی نماز نہیں پڑھی جاتی (سوائے اسی دن کی عصر کے)۔"
          }
        }
      }
    },
    "kerahatFooter_hanbali" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مُعلَّمة بخفّة على القوس وعند المواقيت: نحو 20 دقيقة بعد الشروق، و10 دقائق قبل الظهر، و20 دقيقة قبل المغرب. وفي المذهب الحنبلي لا تُؤدّى فيها صلوات التطوّع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "বৃত্তচাপে ও নামাজের সময়ের পাশে হালকাভাবে চিহ্নিত: সূর্যোদয়ের প্রায় 20 মিনিট পর, যোহরের 10 মিনিট আগে এবং মাগরিবের 20 মিনিট আগে। হাম্বলি মাযহাব অনুযায়ী তখন নফল নামাজ পড়া হয় না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diskretno označeni na luku i uz namaske vakte: oko 20 min nakon izlaska sunca, 10 min prije podneva i 20 min prije akšama. Po hanbelijskom mezhebu tada se ne klanjaju dobrovoljni namazi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezent markiert im Bogen und bei den Zeiten: etwa 20 Min. nach Sonnenaufgang, 10 Min. vor Dhuhr und 20 Min. vor Maghrib. Nach hanbalitischer Lehre werden dann keine freiwilligen Gebete verrichtet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtly marked on the arc and on the times: about 20 min after sunrise, 10 min before Dhuhr and 20 min before Maghrib. According to the Hanbali school, no voluntary prayers are performed then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcados con discreción en el arco y en los horarios: unos 20 min tras la salida del sol, 10 min antes de Dhuhr y 20 min antes de Magrib. Según la escuela hanbalí, en ellos no se rezan oraciones voluntarias."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "با علامتی کم‌رنگ روی کمان و کنار اوقات مشخص شده‌اند: حدود 20 دقیقه پس از طلوع آفتاب، 10 دقیقه پیش از ظهر و 20 دقیقه پیش از مغرب. بر اساس مذهب حنبلی در این اوقات نماز نفل خوانده نمی‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indiquées discrètement sur l’arc et à côté des heures de prière : environ 20 min après le lever du soleil, 10 min avant le Dohr et 20 min avant le Maghreb. Selon l’école hanbalite, on n’accomplit pas de prières facultatives pendant ces moments."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ditandai secara halus pada busur dan di samping waktu salat: sekitar 20 mnt setelah matahari terbit, 10 mnt sebelum Dzuhur, dan 20 mnt sebelum Maghrib. Menurut mazhab Hanbali, salat sunah tidak dikerjakan pada waktu tersebut."
          }
