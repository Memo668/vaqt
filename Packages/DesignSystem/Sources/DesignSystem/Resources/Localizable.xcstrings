    "qcWomanNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تسقط الصلاة في أيام الحيض والنفاس – ولا تُقضى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "হায়েজ ও নিফাসের দিনগুলোতে নামাজ মাফ – এগুলোর কাযা করতে হয় না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "U danima hajza i nifasa namazi otpadaju – oni se ne naklanjaju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An den Tagen der Regel und des Wochenbetts entfallen die Gebete – sie werden nicht nachgeholt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prayers are waived on days of menstruation and postnatal bleeding – they are not made up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los días de menstruación y de sangrado posparto, la oración no es obligatoria – no se recupera."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "در روزهای حیض و نفاس نماز ساقط است – و قضا ندارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les jours de règles et de lochies, la prière n’est pas due – elle ne se rattrape pas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pada hari-hari haid dan nifas, kewajiban salat gugur – salat tersebut tidak diqadha."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nei giorni di mestruazioni e di puerperio la preghiera non è dovuta – non si recupera."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pada hari-hari haid dan nifas, kewajipan solat gugur – solat itu tidak diqada."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Op dagen van menstruatie en kraamvloed vervalt het gebed – het wordt niet ingehaald."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В дни хайда и нифаса обязанность намаза снимается – эти намазы не восполняют."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
