    "highLatNote" : {
      "comment" : "Argumente: 1 = city, 2 = rule",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Sommer wird es in %1$@ nachts nicht ganz dunkel. Fadschr und Ischa werden mit der Regel „%2$@“ geschätzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In summer it never gets fully dark in %1$@. Fajr and Isha are estimated with the “%2$@” rule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En verano no llega a oscurecer del todo en %1$@. Fajr e Isha se estiman con la regla “%2$@”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazın %1$@ şehrinde gece tam kararmaz. İmsak ve yatsı “%2$@” kuralıyla tahmin edilir."
          }
        }
      }
    },
