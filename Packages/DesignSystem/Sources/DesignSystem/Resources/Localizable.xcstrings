      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحدّد أوقات الكراهة التي يعرضها التطبيق وكيف يشرحها. أما وقت العصر فتضبطه منفصلًا من «%@»."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অ্যাপ কোন মাকরুহ সময় দেখাবে এবং কীভাবে ব্যাখ্যা করবে, তা ঠিক করে। আসরের সময় আলাদাভাবে “%@” সেটিংয়ে ঠিক করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Određuje koje mekruh vakte aplikacija prikazuje i kako ih objašnjava. Vakat ikindije podešavate posebno pod „%@“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestimmt, welche Verbotszeiten die App zeigt und wie sie sie erklärt. Die Asr-Zeit stellst du getrennt unter „%@“ ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets which makruh times the app shows and how it explains them. You set the Asr time separately under “%@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determina qué tiempos makruh muestra la app y cómo los explica. La hora del Asr la ajustas aparte en “%@”."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعیین می‌کند برنامه کدام اوقات مکروه را نشان دهد و چگونه آن‌ها را توضیح دهد. وقت عصر را جداگانه در «%@» تنظیم می‌کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Détermine les heures makrouh affichées par l’app et la façon dont elle les explique. Vous réglez l’heure de l’Asr séparément dans « %@ »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menentukan waktu makruh mana yang ditampilkan app dan cara menjelaskannya. Waktu Ashar Anda atur secara terpisah di “%@”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilisce quali momenti makruh mostra l’app e come li spiega. L’orario dell’Asr lo imposti a parte in “%@”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menentukan waktu makruh yang dipaparkan oleh app dan cara ia diterangkan. Anda menetapkan waktu Asar secara berasingan di bawah “%@”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bepaalt welke makroeh-tijden de app toont en hoe die worden uitgelegd. De Asr-tijd stel je apart in bij ‘%@’."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Определяет, какое время макрух показывает приложение и как его объясняет. Время Асра вы задаёте отдельно в разделе «%@»."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Përcakton cilat kohë mekruh shfaq aplikacioni dhe si i shpjegon ato. Kohën e ikindisë e caktoni veçmas te „%@“."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın hangi kerahat vakitlerini gösterdiğini ve nasıl açıkladığını belirler. İkindi vaktini ayrıca “%@” ayarından seçersin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "طے کرتا ہے کہ ایپ کون سے مکروہ اوقات دکھائے اور انہیں کیسے سمجھائے۔ عصر کا وقت آپ الگ سے “%@” میں سیٹ کرتے ہیں۔"
          }
        }
      }
    },
