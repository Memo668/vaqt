    "kerahatAsrBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إن أخّرت العصر إلى وقت الكراهة قبل الغروب، فصلِّ فرض العصر مع ذلك واترك السنة. وتُعدّ الصلاة أداءً في وقتها لا قضاءً، حتى لو غربت الشمس وأنت تصلي. وهذا خاص بالعصر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনি যদি আসর সূর্যাস্তের আগের মাকরুহ সময় পর্যন্ত দেরি করে থাকেন, তবুও আসরের ফরজ পড়ে নিন এবং সুন্নত বাদ দিন। নামাজটি কাযা নয়, বরং সময়মতো আদায় হিসেবে গণ্য হবে – নামাজের মধ্যে সূর্য ডুবে গেলেও। এই বিধান শুধু আসরের জন্য।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ako ste ikindiju odgodili do mekruh vakta pred zalazak sunca, ipak klanjajte farz ikindije, a sunnet izostavite. Namaz se računa kao klanjan na vrijeme, a ne kao naklanjan – čak i ako sunce zađe dok klanjate. Ovo važi samo za ikindiju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du Asr bis in die Verbotszeit vor Sonnenuntergang verschoben, bete trotzdem noch das Farḍ von Asr – die Sunna lässt du dann weg. Das Gebet gilt als rechtzeitig verrichtet, nicht als nachgeholt, selbst wenn die Sonne während des Gebets untergeht. Das gilt nur für Asr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have delayed Asr into the makruh time before sunset, still pray the farḍ of Asr and leave out the sunnah. The prayer counts as on time, not as made up – even if the sun sets while you are praying. This applies only to Asr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si has retrasado el Asr hasta el tiempo makruh antes de la puesta del sol, reza igualmente el farḍ del Asr y deja la sunna. La oración cuenta como hecha a su hora, no como recuperada – aunque el sol se ponga mientras rezas. Esto solo vale para el Asr."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اگر نماز عصر را تا وقت مکروه پیش از غروب به تأخیر انداخته‌اید، باز هم فرض عصر را بخوانید و سنت را ترک کنید. این نماز در وقت خود ادا شده به شمار می‌آید، نه قضا – حتی اگر در حین نماز خورشید غروب کند. این حکم فقط مخصوص عصر است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si vous avez retardé l’Asr jusqu’à l’heure makrouh avant le coucher du soleil, priez quand même le farḍ de l’Asr et laissez la sunna. La prière compte comme accomplie à l’heure, et non comme rattrapée – même si le soleil se couche pendant que vous priez. Cela ne vaut que pour l’Asr."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jika Anda menunda Ashar hingga masuk waktu makruh sebelum matahari terbenam, tetaplah kerjakan fardu Ashar dan tinggalkan sunahnya. Salat itu terhitung tepat waktu, bukan qadha – meskipun matahari terbenam saat Anda sedang salat. Ini hanya berlaku untuk Ashar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se hai rimandato l’Asr fino al momento makruh prima del tramonto, prega comunque il farḍ dell’Asr e tralascia la sunna. La preghiera conta come fatta in tempo, non come recuperata – anche se il sole tramonta mentre preghi. Vale solo per l’Asr."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jika anda telah melewatkan Asar hingga masuk waktu makruh sebelum matahari terbenam, tetaplah tunaikan fardu Asar dan tinggalkan sunatnya. Solat itu dikira dalam waktunya, bukan qada – walaupun matahari terbenam ketika anda sedang solat. Ini hanya berlaku bagi Asar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Heb je Asr uitgesteld tot in de makroeh-tijd vóór zonsondergang, bid dan toch nog de farḍ van Asr en laat de soennah weg. Het gebed telt als op tijd verricht, niet als ingehaald – ook als de zon ondergaat terwijl je bidt. Dit geldt alleen voor Asr."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Если вы отложили Аср до времени макрух перед закатом, всё равно совершите фард Асра, а сунну пропустите. Намаз считается совершённым вовремя, а не восполненным – даже если солнце сядет во время намаза. Это относится только к Асру."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nëse e keni vonuar ikindinë deri në kohën mekruh para perëndimit të diellit, falni gjithsesi farzin e ikindisë dhe lini synetin. Namazi llogaritet i falur në kohë, jo kaza – edhe nëse dielli perëndon ndërsa jeni duke u falur. Kjo vlen vetëm për ikindinë."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkindi namazı kerahat vaktine kadar geciktirildiyse yine de kılınır: sünnet terk edilir, yalnızca farz kılınır. Namaz kazaya kalmaz, vaktinde edâ edilmiş sayılır – namazdayken güneş batsa bile. Bu yalnızca ikindi namazına hastır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اگر آپ نے عصر کو غروب سے پہلے کے مکروہ وقت تک مؤخر کر دیا ہو تو پھر بھی عصر کے فرض پڑھ لیں اور سنتیں چھوڑ دیں۔ یہ نماز قضا نہیں بلکہ وقت پر ادا شمار ہوگی – چاہے نماز کے دوران سورج غروب ہو جائے۔ یہ حکم صرف عصر کے لیے ہے۔"
          }
        }
      }
    },
    "kerahatAsrTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم تصلِّ العصر بعد؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এখনো আসর পড়েননি?"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Još niste klanjali ikindiju?"
