    "ob4Body" : {
      "comment" : "Argumente: 1 = app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ مجاني وسيبقى كذلك. قريبًا ستتمكن من دعمنا بتبرّع، لنتمكن من صيانة التطبيق ومواصلة تطويره. التبرّع اختياري: يبقى التطبيق كاملًا للجميع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ বিনামূল্যে এবং সবসময় তা-ই থাকবে। শিগগিরই আপনি অনুদান দিয়ে আমাদের সহায়তা করতে পারবেন, যাতে আমরা অ্যাপটির রক্ষণাবেক্ষণ ও আরও উন্নতি করতে পারি। এটি স্বেচ্ছামূলক: অ্যাপটি সবার জন্য সম্পূর্ণই থাকবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikacija %@ je besplatna i takva će i ostati. Uskoro ćete nas moći podržati donacijom kako bismo aplikaciju mogli održavati i dalje unapređivati. Donacija je dobrovoljna: aplikacija ostaje potpuna za sve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kostenlos und bleibt es. Damit wir die App pflegen und weiterentwickeln können, kannst du uns bald mit einer Spende unterstützen. Freiwillig: Die App bleibt für alle vollständig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is free and will stay that way. Soon you’ll be able to support us with a donation so we can maintain the app and keep improving it. It’s voluntary: the app stays complete for everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es gratis y lo seguirá siendo. Pronto podrás apoyarnos con un donativo para que podamos mantener la app y seguir mejorándola. Es voluntario: la app sigue completa para todos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ رایگان است و رایگان می‌ماند. به‌زودی می‌توانید با کمک مالی از ما حمایت کنید تا بتوانیم برنامه را نگهداری و بهتر کنیم. این کار داوطلبانه است: برنامه برای همه کامل می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’app %@ est gratuite et le restera. Bientôt, vous pourrez nous soutenir par un don pour que nous puissions entretenir l’app et continuer à l’améliorer. C’est facultatif : l’app reste complète pour tout le monde."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ gratis dan akan tetap gratis. Sebentar lagi Anda dapat mendukung kami dengan donasi agar kami bisa merawat dan terus mengembangkan app ini. Sifatnya sukarela: app tetap lengkap untuk semua orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’app %@ è gratuita e lo resterà. Presto potrai sostenerci con una donazione, così potremo mantenere l’app e continuare a migliorarla. È facoltativo: l’app resta completa per tutti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ percuma dan akan kekal begitu. Tidak lama lagi anda boleh menyokong kami dengan derma supaya kami dapat menyelenggara dan terus menambah baik app ini. Ia secara sukarela: app kekal lengkap untuk semua."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ is gratis en blijft dat ook. Binnenkort kun je ons steunen met een donatie, zodat we de app kunnen onderhouden en blijven verbeteren. Het is vrijwillig: de app blijft voor iedereen volledig."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Приложение %@ бесплатно и останется таким. Скоро вы сможете поддержать нас пожертвованием, чтобы мы могли сопровождать и развивать приложение. Это добровольно: приложение остаётся полностью доступным для всех."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikacioni %@ është falas dhe do të mbetet i tillë. Së shpejti do të mund të na mbështetni me një donacion, që ta mirëmbajmë aplikacionin dhe ta përmirësojmë vazhdimisht. Donacioni është vullnetar: aplikacioni mbetet i plotë për të gjithë."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ücretsizdir ve öyle kalacak. Uygulamanın bakımını yapıp geliştirmeye devam edebilmemiz için yakında bağışla destek olabileceksin. Tamamen gönüllü: Uygulama herkes için eksiksiz kalır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ مفت ہے اور مفت ہی رہے گی۔ جلد ہی آپ عطیہ دے کر ہماری مدد کر سکیں گے تاکہ ہم ایپ کو برقرار رکھیں اور بہتر بناتے رہیں۔ یہ رضاکارانہ ہے: ایپ سب کے لیے مکمل رہے گی۔"
          }
        }
      }
    },
