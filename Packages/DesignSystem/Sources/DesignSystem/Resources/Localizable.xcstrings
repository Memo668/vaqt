    "kerahatOtherBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "في صلاة الجنازة والصلوات التي لها سبب، مثل تحية المسجد، تختلف المذاهب. إن كنت في شك فاسأل إمامًا من مذهبك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "জানাজার নামাজ এবং বিশেষ কারণে পড়া নামাজে, যেমন তাহিয়্যাতুল মসজিদ, মাযহাবগুলোর মত ভিন্ন। সন্দেহ থাকলে আপনার মাযহাবের কোনো ইমামকে জিজ্ঞেস করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kod dženaze-namaza i namaza s posebnim povodom, kao što je namaz pozdrava džamiji, mezhebi se razlikuju. Ako niste sigurni, pitajte imama svog mezheba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Totengebet und bei Gebeten mit besonderem Anlass, etwa dem Begrüßungsgebet in der Moschee, unterscheiden sich die Rechtsschulen. Frag im Zweifel einen Imam deiner Rechtsschule."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For the funeral prayer and prayers with a particular reason, such as greeting the mosque, the schools differ. If in doubt, ask an imam of your school."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la oración fúnebre y en las oraciones con un motivo especial, como la oración de saludo a la mezquita, las escuelas jurídicas difieren. Si tienes dudas, consulta a un imán de tu escuela jurídica."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "درباره نماز جنازه و نمازهایی که سبب خاصی دارند، مانند تحیت مسجد، مذاهب نظرهای متفاوتی دارند. در صورت تردید از امامی از مذهب خود بپرسید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour la prière funéraire et les prières liées à une occasion particulière, comme la prière de salutation de la mosquée, les écoles juridiques divergent. En cas de doute, demandez à un imam de votre école juridique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Untuk salat jenazah dan salat yang memiliki sebab khusus, misalnya tahiyatul masjid, mazhab-mazhab berbeda pendapat. Jika ragu, tanyakan kepada imam dari mazhab Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per la preghiera funebre e per le preghiere legate a un’occasione particolare, come la preghiera di saluto alla moschea, le scuole giuridiche differiscono. Nel dubbio, chiedi a un imam della tua scuola giuridica."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bagi solat jenazah dan solat yang mempunyai sebab tertentu, seperti tahiyatul masjid, pendapat mazhab berbeza. Jika ragu, tanya imam daripada mazhab anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bij het dodengebed en bij gebeden met een bijzondere aanleiding, zoals het begroetingsgebed in de moskee, verschillen de rechtsscholen. Vraag het bij twijfel aan een imam van je rechtsschool."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В отношении джаназа-намаза и намазов по особому поводу, например намаза приветствия мечети, мазхабы расходятся. Если сомневаетесь, спросите имама своего мазхаба."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Për namazin e xhenazes dhe namazet me shkak të veçantë, si namazi i përshëndetjes së xhamisë, medhhebet ndryshojnë. Nëse nuk jeni të sigurt, pyetni një imam të medhhebit tuaj."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cenaze namazı ve tahiyyetü’l-mescid gibi bir sebebe bağlı namazlarda mezhepler farklı hükümler verir. Emin değilsen mezhebinden bir imama danış."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نمازِ جنازہ اور کسی خاص سبب والی نمازوں، جیسے تحیۃ المسجد، میں مسالک کی رائے مختلف ہے۔ شک ہو تو اپنے مسلک کے کسی امام سے پوچھیں۔"
          }
        }
      }
    },
