    "qadaFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختلف العلماء في وجوب قضاء الصلوات الفائتة وكيفيته. إن كنت في شك فاسأل إمامك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ছুটে যাওয়া নামাজের কাযা করতে হবে কি না এবং কীভাবে, সে বিষয়ে আলেমদের মতভেদ আছে। সন্দেহ থাকলে আপনার ইমামকে জিজ্ঞেস করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Učenjaci se razilaze o tome da li se i kako naklanjaju propušteni namazi. Ako niste sigurni, pitajte svog imama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob und wie verpasste Gebete nachzuholen sind, beantworten Gelehrte unterschiedlich. Frag im Zweifel deinen Imam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholars differ on whether and how missed prayers are made up. If unsure, ask your imam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sabios difieren sobre si y cómo recuperar las oraciones perdidas. Si tienes dudas, consulta a tu imán."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "علما درباره اینکه آیا و چگونه نمازهای فوت‌شده قضا شوند، نظرهای متفاوتی دارند. در صورت تردید از امام خود بپرسید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les savants divergent sur la question de savoir si et comment rattraper les prières manquées. En cas de doute, demandez à votre imam."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ulama berbeda pendapat tentang apakah dan bagaimana salat yang terlewat diqadha. Jika ragu, tanyakan kepada imam Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I sapienti hanno opinioni diverse su se e come recuperare le preghiere mancate. Nel dubbio, chiedi al tuo imam."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ulama berbeza pendapat sama ada dan bagaimana solat yang tertinggal perlu diqada. Jika ragu, tanya imam anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geleerden verschillen van mening over of en hoe gemiste gebeden worden ingehaald. Vraag het bij twijfel aan je imam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Учёные расходятся во мнениях, нужно ли и как восполнять пропущенные намазы. Если сомневаетесь, спросите своего имама."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dijetarët kanë mendime të ndryshme nëse dhe si falen kaza namazet e humbura. Nëse nuk jeni të sigurt, pyetni imamin tuaj."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaçırılan namazların kazası konusunda âlimlerin görüşleri farklıdır. Emin değilsen imamına danış."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "چھوٹی ہوئی نمازوں کی قضا کی جائے یا نہیں اور کیسے، اس بارے میں علماء کی آراء مختلف ہیں۔ شک ہو تو اپنے امام سے پوچھیں۔"
          }
        }
      }
    },
    "qadaIntro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تابِع الصلوات التي تريد قضاءها. تبقى كل البيانات على جهازك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "যে নামাজগুলোর কাযা আদায় করতে চান, সেগুলোর হিসাব রাখুন। সবকিছু আপনার ডিভাইসেই থাকে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pratite namaze koje želite naklanjati. Sve ostaje na vašem uređaju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte im Blick, welche Gebete du nachholen möchtest. Alles bleibt auf deinem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep track of the prayers you want to make up. Everything stays on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva la cuenta de las oraciones que quieres recuperar. Todo se queda en tu dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نمازهایی را که می‌خواهید قضا کنید پیگیری کنید. همه‌چیز روی دستگاه شما می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suivez les prières que vous souhaitez rattraper. Tout reste sur votre appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catat salat yang ingin Anda qadha. Semuanya tetap di perangkat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni traccia delle preghiere che vuoi recuperare. Tutto resta sul tuo dispositivo."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jejaki solat yang ingin anda qada. Semuanya kekal pada peranti anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd bij welke gebeden je wilt inhalen. Alles blijft op je apparaat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отслеживайте намазы, которые хотите восполнить. Все данные остаются на вашем устройстве."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ndiqni namazet që doni t’i falni kaza. Gjithçka mbetet në pajisjen tuaj."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaza etmek istediğin namazları takip et. Her şey cihazında kalır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "جن نمازوں کی قضا آپ ادا کرنا چاہتے ہیں، ان کا حساب رکھیں۔ سب کچھ آپ کے آلے پر ہی رہتا ہے۔"
          }
        }
      }
    },
