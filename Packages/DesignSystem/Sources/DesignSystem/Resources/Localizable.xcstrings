    "qadaResetBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ستُعاد الصلوات المتبقية وخطتك وما أدخلته في الحاسبة إلى الصفر. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "বাকি নামাজ, আপনার পরিকল্পনা ও হিসাবের তথ্য শূন্য করা হবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Preostali namazi, vaš plan i unosi u kalkulatoru bit će postavljeni na nulu. Ovo se ne može poništiti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offene Gebete, Plan und die Angaben im Rechner werden auf null gesetzt. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open prayers, your plan and the calculator entries are set to zero. This can’t be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las oraciones pendientes, tu plan y los datos del cálculo se pondrán a cero. Esta acción no se puede deshacer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نمازهای باقی‌مانده، برنامه شما و مقادیر محاسبه‌گر صفر می‌شوند. این کار برگشت‌پذیر نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les prières à rattraper, votre plan et les données du calcul seront remis à zéro. Cette action est irréversible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Salat yang belum diqadha, rencana Anda, dan isian di kalkulator akan diatur ke nol. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le preghiere da recuperare, il piano e i dati del calcolo verranno azzerati. Questa azione non può essere annullata."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solat yang belum diqada, rancangan anda dan maklumat dalam kalkulator akan ditetapkan kepada sifar. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Openstaande gebeden, je plan en de gegevens van de berekening worden op nul gezet. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оставшиеся намазы, ваш план и данные в калькуляторе будут обнулены. Это действие нельзя отменить."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Namazet e mbetura, plani juaj dhe të dhënat në llogaritës vendosen në zero. Ky veprim nuk mund të zhbëhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kılınmamış namazlar, plan ve hesaplayıcıdaki bilgiler sıfırlanır. Bu işlem geri alınamaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "باقی نمازیں، آپ کا منصوبہ اور حساب میں درج معلومات صفر ہو جائیں گی۔ اس عمل کو واپس نہیں لیا جا سکتا۔"
          }
        }
      }
    },
