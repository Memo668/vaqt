    "privacyBody2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, keine Werbung, keine Analyse-Tools. Dein Standort wird nur auf diesem Gerät zur Berechnung verwendet und verlässt es nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account, no ads, no analytics. Your location is only used on this device to calculate prayer times and never leaves it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuentas, sin anuncios, sin herramientas de análisis. Tu ubicación solo se usa en este dispositivo para calcular los horarios y nunca sale de él."
          }
        },
        "tr" : {
