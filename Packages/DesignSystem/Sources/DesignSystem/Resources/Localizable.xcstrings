    "ob1Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بلا إعلانات، وبلا تتبّع، وغير ربحي. فقط ما تحتاج إليه، لا أكثر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "বিজ্ঞাপনমুক্ত, ট্র্যাকিংমুক্ত ও অলাভজনক। শুধু যা দরকার, আর কিছু নয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bez reklama, bez praćenja i neprofitno. Samo ono što vam treba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werbefrei, ohne Tracking und gemeinnützig. Nur das, was du brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad-free, tracking-free and non-profit. Just what you need, nothing else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin anuncios, sin rastreo y sin ánimo de lucro. Solo lo que necesitas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بدون تبلیغات، بدون ردیابی و غیرانتفاعی. فقط آنچه نیاز دارید، نه بیشتر."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sans publicité, sans suivi et à but non lucratif. L’essentiel, rien de plus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanpa iklan, tanpa pelacakan, dan nirlaba. Hanya yang Anda butuhkan, tidak lebih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Senza pubblicità, senza tracciamento e senza scopo di lucro. Solo ciò che ti serve, nient’altro."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanpa iklan, tanpa penjejakan dan bukan untung. Hanya yang anda perlukan, tidak lebih."
