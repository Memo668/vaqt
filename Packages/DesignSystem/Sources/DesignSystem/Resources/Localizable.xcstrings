    "gAsrKerahat" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "في وقت الكراهة قبل الغروب صلِّ الفرض وحده – وتُعدّ مع ذلك أداءً في وقتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "সূর্যাস্তের আগের মাকরুহ সময়ে শুধু ফরজ পড়ুন – তবুও তা সময়মতো আদায় হিসেবে গণ্য হবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "U mekruh vaktu pred zalazak sunca klanjajte samo farz – namaz se i dalje računa kao klanjan na vrijeme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Verbotszeit vor Sonnenuntergang betest du nur noch das Farḍ – das Gebet gilt trotzdem als rechtzeitig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the makruh time before sunset, pray only the farḍ – it still counts as on time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el tiempo makruh antes de la puesta del sol, reza solo el farḍ – aun así cuenta como hecha a su hora."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "در وقت مکروه پیش از غروب، فقط فرض را بخوانید – باز هم در وقت خود ادا شده به شمار می‌آید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pendant l’heure makrouh avant le coucher du soleil, priez seulement le farḍ – la prière compte quand même comme accomplie à l’heure."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pada waktu makruh sebelum matahari terbenam, kerjakan fardunya saja – salat tetap terhitung tepat waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nel momento makruh prima del tramonto, prega solo il farḍ – conta comunque come fatta in tempo."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pada waktu makruh sebelum matahari terbenam, tunaikan fardu sahaja – solat tetap dikira dalam waktunya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bid in de makroeh-tijd vóór zonsondergang alleen de farḍ – het gebed telt nog steeds als op tijd."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Во время макрух перед закатом совершайте только фард – намаз всё равно считается совершённым вовремя."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Në kohën mekruh para perëndimit të diellit falni vetëm farzin – namazi llogaritet përsëri i falur në kohë."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güneş batmadan önceki kerahat vaktinde yalnızca farz kılınır – namaz yine de vaktinde kılınmış sayılır."
          }
