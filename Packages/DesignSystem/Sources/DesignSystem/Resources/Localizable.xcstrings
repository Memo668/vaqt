    "guideFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعرض هذا الدليل الترتيب الشائع. وتختلف التفاصيل بين المذاهب الفقهية – والأفضل أن تتعلّم الصلاة في مسجدك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই নির্দেশিকা প্রচলিত নিয়ম দেখায়। মাযহাবভেদে খুঁটিনাটি ভিন্ন হয় – সম্ভব হলে আপনার মসজিদে নামাজ শিখুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovo uputstvo prikazuje uobičajen redoslijed. Pojedinosti se razlikuju među mezhebima – namaz je najbolje naučiti u svojoj džamiji."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anleitung zeigt den üblichen Ablauf. Einzelheiten unterscheiden sich je nach Rechtsschule – lerne das Gebet am besten mit deiner Moschee."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This guide shows the common sequence. Details differ between schools of law – ideally learn the prayer with your mosque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta guía muestra la secuencia habitual. Los detalles varían según la escuela jurídica; lo mejor es aprender la oración en tu mezquita."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "این راهنما ترتیب رایج را نشان می‌دهد. جزئیات در مذاهب فقهی متفاوت است – بهتر است نماز را در مسجد خود بیاموزید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce guide montre le déroulement le plus courant. Les détails varient selon les écoles juridiques – idéalement, apprenez la prière avec votre mosquée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Panduan ini menunjukkan urutan yang umum. Rinciannya berbeda antarmazhab – sebaiknya pelajari salat di masjid Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questa guida mostra la sequenza più comune. I dettagli variano tra le scuole giuridiche – l’ideale è imparare la preghiera nella tua moschea."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Panduan ini menunjukkan urutan yang lazim. Butirannya berbeza mengikut mazhab – sebaik-baiknya pelajari solat di masjid anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deze uitleg toont de gebruikelijke volgorde. Details verschillen per rechtsschool – leer het gebed het liefst samen met je moskee."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Инструкция показывает общепринятый порядок. В разных мазхабах детали различаются – лучше всего изучите намаз в своей мечети."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ky udhëzues tregon radhën e zakonshme. Hollësitë ndryshojnë sipas medhhebeve – namazin më mirë mësojeni në xhaminë tuaj."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu rehber genel kılınışı gösterir. Ayrıntılar mezhebe göre değişir; namazı en iyi camindeki hocandan öğren."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "یہ رہنمائی عام طریقہ بتاتی ہے۔ تفصیلات فقہی مسالک کے لحاظ سے مختلف ہیں – بہتر ہے کہ نماز اپنی مسجد میں سیکھیں۔"
          }
        }
      }
    },
