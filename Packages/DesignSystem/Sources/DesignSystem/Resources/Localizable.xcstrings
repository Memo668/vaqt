    "s_tashD" : {
      "comment" : "TODO(review): Text der Anleitung – fachlich ungeprüft; vor dem App Store von einem Imam oder Gelehrten prüfen lassen (Spec § 6.14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بعد الركعة الثانية وفي ختام الصلاة. وفي الختام تليه الصلاة على النبي ودعاء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "দ্বিতীয় রাকাতের পর এবং শেষে। শেষে দরুদ শরীফ ও দোয়া পড়া হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nakon 2. rekata i na kraju. Na kraju slijede salavat na Poslanika i dova."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der 2. Rakʿa und am Ende. Am Ende folgen Segensgebet und Bittgebet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the 2nd rakʿah and at the end. At the end, blessings on the Prophet and a supplication follow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras la 2.ª rakʿa y al final. Al final siguen las bendiciones sobre el Profeta y una súplica."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پس از رکعت دوم و در پایان. در پایان، صلوات بر پیامبر و دعا می‌آید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après la 2e rakʿa et à la fin. À la fin suivent la prière sur le Prophète et une invocation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setelah rakaat ke-2 dan di akhir salat. Di akhir, dilanjutkan dengan selawat Nabi dan doa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dopo la 2ª rakʿa e alla fine. Alla fine seguono le benedizioni sul Profeta e un’invocazione."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Selepas rakaat kedua dan pada akhir solat. Pada akhirnya, diikuti selawat ke atas Nabi dan doa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na de 2e rakʿa en aan het einde. Aan het einde volgen de zegenbede over de Profeet en een smeekbede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "После 2-го ракаата и в конце. В конце следуют благословение Пророка (салават) и мольба (дуа)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pas rekatit të 2-të dhe në fund. Në fund vijojnë salavatet për Pejgamberin dhe një dua."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. rekâttan sonra ve sonda. Sonda salavat ve dua okunur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دوسری رکعت کے بعد اور آخر میں۔ آخر میں درود شریف اور دعا پڑھی جاتی ہے۔"
          }
        }
      }
    },
