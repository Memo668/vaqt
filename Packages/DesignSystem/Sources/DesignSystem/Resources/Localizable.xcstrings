    "obMadhabBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بحسبه تُحدَّد أوقات الكراهة وشرحها. ويمكنك تغييره لاحقًا في الإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "মাকরুহ সময় ও তার ব্যাখ্যা এর ওপর নির্ভর করে। পরে সেটিংসে এটি বদলাতে পারবেন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prema njemu se određuju mekruh vakti i njihovo objašnjenje. Možete ga kasnije promijeniti u Postavkama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach richten sich die Verbotszeiten und ihre Erklärung. Du kannst sie später in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sets the makruh times and how they are explained. You can change it later in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ella dependen los tiempos makruh y su explicación. Puedes cambiarla más tarde en Ajustes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اوقات مکروه و توضیح آن‌ها بر این اساس تعیین می‌شوند. بعداً می‌توانید آن را در تنظیمات تغییر دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elle détermine les heures makrouh et leur explication. Vous pouvez la modifier plus tard dans les Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu makruh dan penjelasannya mengikuti pilihan ini. Anda dapat mengubahnya nanti di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da essa dipendono i momenti makruh e la loro spiegazione. Puoi cambiarla in seguito nelle Impostazioni."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu makruh dan penerangannya mengikut pilihan ini. Anda boleh menukarnya kemudian dalam Seting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hiervan hangen de makroeh-tijden en de uitleg ervan af. Je kunt die later wijzigen in Instellingen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "От него зависят время макрух и то, как оно объясняется. Вы можете изменить его позже в Настройках."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sipas tij përcaktohen kohët mekruh dhe shpjegimi i tyre. Mund ta ndryshoni më vonë te Cilësimet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerahat vakitleri ve açıklamaları buna göre belirlenir. Daha sonra Ayarlar’dan değiştirebilirsin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مکروہ اوقات اور ان کی وضاحت اسی کے مطابق ہوتی ہے۔ آپ اسے بعد میں سیٹنگز میں بدل سکتے ہیں۔"
          }
        }
      }
    },
