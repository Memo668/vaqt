    "hlManualFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إذا لم تبلغ الشمس الزاوية المحددة، يُستخدم الجزء المقابل من الليل (الزاوية ÷ 60)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "সূর্য নির্ধারিত কোণে না পৌঁছালে রাতের সংশ্লিষ্ট অংশ ধরা হয় (কোণ ÷ 60)।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ako sunce ne dostigne postavljeni ugao, koristi se odgovarajući dio noći (ugao ÷ 60)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreicht die Sonne den eingestellten Winkel nicht, gilt der entsprechende Anteil der Nacht (Winkel ÷ 60)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the sun does not reach the set angle, the matching portion of the night is used (angle ÷ 60)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el sol no alcanza el ángulo fijado, se usa la parte correspondiente de la noche (ángulo ÷ 60)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اگر خورشید به زاویهٔ تعیین‌شده نرسد، بخش متناظر شب به کار می‌رود (زاویه ÷ 60)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si le soleil n’atteint pas l’angle choisi, la part de nuit correspondante est utilisée (angle ÷ 60)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jika matahari tidak mencapai sudut yang diatur, digunakan bagian malam yang sesuai (sudut ÷ 60)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se il sole non raggiunge l’angolo impostato, si usa la parte di notte corrispondente (angolo ÷ 60)."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jika matahari tidak mencapai sudut yang ditetapkan, bahagian malam yang sepadan digunakan (sudut ÷ 60)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bereikt de zon de ingestelde hoek niet, dan geldt het overeenkomstige deel van de nacht (hoek ÷ 60)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Если солнце не опускается до заданного угла, берётся соответствующая доля ночи (угол ÷ 60)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nëse dielli nuk e arrin këndin e caktuar, përdoret pjesa përkatëse e natës (këndi ÷ 60)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güneş ayarlanan açıya ulaşmazsa gecenin buna karşılık gelen payı kullanılır (açı ÷ 60)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اگر سورج مقررہ زاویے تک نہ پہنچے تو رات کا متعلقہ حصہ لیا جاتا ہے (زاویہ ÷ 60)۔"
          }
        }
      }
    },
