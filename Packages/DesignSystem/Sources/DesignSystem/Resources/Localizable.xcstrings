    "s_sujudD" : {
      "comment" : "TODO(review): Text der Anleitung – fachlich ungeprüft; vor dem App Store von einem Imam oder Gelehrten prüfen lassen (Spec § 6.14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الجبهة والأنف واليدان والركبتان وأطراف القدمين على الأرض. ثلاث مرات – اجلس قليلًا، ثم مرة ثانية:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কপাল, নাক, হাত, হাঁটু ও পায়ের আঙুল মাটিতে। তিনবার – সামান্য বসুন, তারপর দ্বিতীয়বার:"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Čelo, nos, šake, koljena i prsti nogu na tlu. Tri puta – kratko sjednite, a zatim drugi put:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stirn, Nase, Hände, Knie und Zehen auf dem Boden. Dreimal – kurz sitzen, dann ein zweites Mal:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forehead, nose, hands, knees and toes on the ground. Three times – sit briefly, then a second time:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frente, nariz, manos, rodillas y dedos de los pies en el suelo. Tres veces; siéntate un momento y repite:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پیشانی، بینی، دست‌ها، زانوها و انگشتان پا روی زمین. سه بار – کمی بنشینید، سپس بار دوم:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Front, nez, mains, genoux et orteils au sol. Trois fois – asseyez-vous brièvement, puis une seconde fois :"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dahi, hidung, kedua tangan, lutut, dan jari kaki menempel di lantai. Tiga kali – duduk sebentar, lalu sujud untuk kedua kalinya:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fronte, naso, mani, ginocchia e dita dei piedi a terra. Tre volte – siediti brevemente, poi una seconda volta:"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dahi, hidung, tangan, lutut dan jari kaki di atas lantai. Tiga kali – duduk sebentar, kemudian sujud kali kedua:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voorhoofd, neus, handen, knieën en tenen op de grond. Drie keer – kort zitten, dan een tweede keer:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Лоб, нос, руки, колени и пальцы ног на полу. Трижды – коротко сядьте, затем второй раз:"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Balli, hunda, duart, gjunjët dhe gishtat e këmbëve në tokë. Tri herë – uluni shkurt, pastaj herën e dytë:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alın, burun, eller, dizler ve ayak parmakları yerde. Üç kez – kısa oturuş, sonra ikinci secde:"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پیشانی، ناک، ہاتھ، گھٹنے اور پاؤں کی انگلیاں زمین پر۔ تین بار – تھوڑی دیر بیٹھیں، پھر دوسری بار:"
          }
        }
      }
    },
