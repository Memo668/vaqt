        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اشتہارات سے پاک، ٹریکنگ کے بغیر اور غیر منافع بخش۔ صرف وہی جو آپ کو چاہیے، اور کچھ نہیں۔"
