    "wkIntroBody" : {
      "comment" : "Argumente: 1 = p. TODO(review): Entwurf für „Gebet Schritt für Schritt“ (Spec § 9.6) – fachlich ungeprüft wie die übrige Anleitung; vor dem App Store von einem Imam oder Gelehrten prüfen lassen (Spec § 6.14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "توضّأ واستقبل القبلة. وانوِ بقلبك صلاة %@. ثم ابدأ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অজু করুন এবং কিবলামুখী হোন। মনে মনে %@ নামাজের নিয়ত করুন। তারপর শুরু করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uzmite abdest i okrenite se prema kibli. U srcu donesite nijet za namaz: %@. Zatim počnite."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm die Gebetswaschung vor und stell dich in Richtung Qibla. Fasse im Herzen die Absicht für %@. Dann geht es los."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make wudu and face the Qibla. Make the intention for %@ in your heart. Then begin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz el wudu y ponte hacia la Qibla. Haz en tu corazón la intención de %@. Después, empieza."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وضو بگیرید و رو به قبله بایستید. در دل نیت نماز %@ کنید. سپس شروع کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faites vos ablutions (woudou) et tournez-vous vers la Qibla. Formulez dans votre cœur l’intention de prier %@. Puis commencez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Berwudulah dan menghadaplah ke kiblat. Berniatlah dalam hati untuk salat %@. Lalu mulailah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fai il wudu e rivolgiti verso la qibla. Formula nel cuore l’intenzione per %@. Poi inizia."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ambil wuduk dan hadap ke kiblat. Berniat di dalam hati untuk solat %@. Kemudian mulakan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verricht de woedoe en richt je naar de Qibla. Maak in je hart de intentie voor %@. Begin dan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Совершите омовение (вуду) и встаньте лицом к кибле. Сделайте в сердце намерение совершить намаз %@. Затем начинайте."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merrni abdes dhe kthehuni nga kibla. Bëni me zemër nijet për namazin: %@. Pastaj filloni."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abdest al ve kıbleye yönel. Kalbinden %@ namazına niyet et. Sonra başla."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وضو کریں اور قبلہ رُخ ہو جائیں۔ دل میں %@ کی نیت کریں۔ پھر شروع کریں۔"
          }
        }
      }
    },
