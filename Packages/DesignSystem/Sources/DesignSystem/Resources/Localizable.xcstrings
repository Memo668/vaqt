    "kerahatInfoFoot" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وفق المذهب الحنفي. الفترات تقريبية: 45 دقيقة بعد الشروق، و10 دقائق قبل الظهر، و45 دقيقة قبل الغروب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "হানাফি মাযহাব অনুযায়ী। সময়গুলো আনুমানিক: সূর্যোদয়ের পর 45 মিনিট, যোহরের আগে 10 মিনিট এবং সূর্যাস্তের আগে 45 মিনিট।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prema hanefijskom mezhebu. Vremena su približna: 45 minuta nakon izlaska sunca, 10 minuta prije podneva i 45 minuta prije zalaska sunca."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der hanafitischen Rechtsschule. Die Fenster sind Näherungen: 45 Minuten nach Sonnenaufgang, 10 Minuten vor Dhuhr und 45 Minuten vor Sonnenuntergang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "According to the Hanafi school. The windows are approximate: 45 minutes after sunrise, 10 minutes before Dhuhr and 45 minutes before sunset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según la escuela hanafí. Las franjas son aproximadas: 45 minutos tras la salida del sol, 10 minutos antes de Dhuhr y 45 minutos antes de la puesta del sol."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بر اساس مذهب حنفی. بازه‌ها تقریبی‌اند: 45 دقیقه پس از طلوع آفتاب، 10 دقیقه پیش از ظهر و 45 دقیقه پیش از غروب آفتاب."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Selon l’école hanafite. Les durées sont approximatives : 45 minutes après le lever du soleil, 10 minutes avant le Dohr et 45 minutes avant le coucher du soleil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menurut mazhab Hanafi. Rentang waktunya merupakan perkiraan: 45 menit setelah matahari terbit, 10 menit sebelum Dzuhur, dan 45 menit sebelum matahari terbenam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Secondo la scuola hanafita. Gli intervalli sono approssimativi: 45 minuti dopo l’alba, 10 minuti prima di Dhuhr e 45 minuti prima del tramonto."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menurut mazhab Hanafi. Tempoh ini ialah anggaran: 45 minit selepas matahari terbit, 10 minit sebelum Zohor dan 45 minit sebelum matahari terbenam."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volgens de hanafitische school. De tijden zijn bij benadering: 45 minuten na zonsopgang, 10 minuten vóór Dhuhr en 45 minuten vóór zonsondergang."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "По ханафитскому мазхабу. Время указано приблизительно: 45 минут после восхода, 10 минут до Зухра и 45 минут до заката."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sipas medhhebit hanefi. Kohët janë të përafërta: 45 minuta pas lindjes së diellit, 10 minuta para drekës dhe 45 minuta para perëndimit të diellit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanefî mezhebine göre. Süreler yaklaşıktır: güneş doğduktan sonra 45 dakika, öğleden önce 10 dakika, güneş batmadan önce 45 dakika."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حنفی مسلک کے مطابق۔ اوقات تقریبی ہیں: طلوعِ آفتاب کے بعد 45 منٹ، ظہر سے پہلے 10 منٹ اور غروبِ آفتاب سے پہلے 45 منٹ۔"
          }
        }
      }
    },
    "kerahatInfoL1" : {
      "extractionState" : "manual",
      "localizations" : {
