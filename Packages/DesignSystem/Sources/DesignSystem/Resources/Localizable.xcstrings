    "s_qiyamD" : {
      "comment" : "TODO(review): Text der Anleitung – fachlich ungeprüft; vor dem App Store von einem Imam oder Gelehrten prüfen lassen (Spec § 6.14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اقرأ الفاتحة. وفي الركعتين الأوليين تليها سورة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "সূরা ফাতিহা পড়ুন। প্রথম দুই রাকাতে এরপর আরেকটি সূরা পড়ুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proučite suru al-Fātiḥa. U prva dva rekata slijedi još jedna sura."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies al-Fātiha. In den ersten zwei Rakʿas folgt eine weitere Sure."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recite al-Fātiḥa. In the first two rakʿahs another sūrah follows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recita al-Fātiḥa. En las dos primeras rakʿas sigue otra sura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سوره فاتحه را بخوانید. در دو رکعت اول، پس از آن سوره‌ای دیگر هم می‌آید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Récitez al-Fātiḥa. Dans les deux premières rakʿas, une autre sourate suit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baca Al-Fatihah. Pada dua rakaat pertama, dilanjutkan dengan surah lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recita al-Fātiḥa. Nelle prime due rakʿa segue un’altra sura."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baca al-Fatihah. Dalam dua rakaat pertama, diikuti dengan surah lain."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reciteer al-Fātiḥa. In de eerste twee rakʿaat volgt nog een soera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Прочитайте аль-Фатиху. В первых двух ракаатах за ней следует ещё одна сура."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lexoni suren al-Fātiḥa. Në dy rekatet e para vijon edhe një sure tjetër."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fâtiha’yı oku. İlk iki rekâtta ardından bir sure daha okunur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سورۂ فاتحہ پڑھیں۔ پہلی دو رکعتوں میں اس کے بعد کوئی اور سورت پڑھیں۔"
          }
        }
      }
    },
