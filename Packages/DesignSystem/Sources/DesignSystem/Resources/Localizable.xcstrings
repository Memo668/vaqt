    "supportLead" : {
      "comment" : "Argumente: 1 = app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ مجاني، بلا إعلانات وبلا تتبّع. تغطي التبرعات التكاليف الجارية ليبقى كذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ বিনামূল্যে, বিজ্ঞাপন ও ট্র্যাকিং ছাড়া। অনুদান চলমান খরচ মেটায়, যাতে এটি এমনই থাকে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikacija %@ je besplatna, bez reklama i bez praćenja. Donacije pokrivaju tekuće troškove kako bi tako i ostalo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kostenlos, ohne Werbung und ohne Tracking. Damit das so bleibt, tragen Spenden die laufenden Kosten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is free, with no ads and no tracking. Donations cover the running costs so it can stay that way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es gratis, sin anuncios y sin rastreo. Los donativos cubren los gastos para que siga así."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ رایگان است، بدون تبلیغات و بدون ردیابی. کمک‌های مالی هزینه‌های جاری را پوشش می‌دهند تا همین‌طور بماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’app %@ est gratuite, sans publicité et sans suivi. Les dons couvrent les frais de fonctionnement pour qu’elle le reste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ gratis, tanpa iklan, dan tanpa pelacakan. Donasi menutup biaya operasional agar tetap seperti itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’app %@ è gratuita, senza pubblicità e senza tracciamento. Le donazioni coprono i costi di gestione perché possa restare così."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ percuma, tanpa iklan dan tanpa penjejakan. Derma menampung kos operasi supaya ia kekal begitu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ is gratis, zonder reclame en zonder tracking. Donaties dekken de lopende kosten, zodat dat zo blijft."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Приложение %@ бесплатное, без рекламы и отслеживания. Пожертвования покрывают текущие расходы, чтобы так было и дальше."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikacioni %@ është falas, pa reklama dhe pa gjurmim. Donacionet mbulojnë shpenzimet e vazhdueshme, që të mbetet kështu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ücretsizdir, reklam ve takip içermez. Böyle kalması için bağışlar düzenli giderleri karşılar."
