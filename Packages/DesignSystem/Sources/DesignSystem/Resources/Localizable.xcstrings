    "s_sujudD" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stirn, Nase, Hände, Knie und Zehen auf dem Boden. Dreimal – kurz sitzen, dann ein zweites Mal:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forehead, nose, hands, knees and toes on the ground. Three times – sit briefly, then a second time:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frente, nariz, manos, rodillas y dedos de los pies en el suelo. Tres veces; siéntate un momento y repite:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alın, burun, eller, dizler ve ayak parmakları yerde. Üç kez – kısa oturuş, sonra ikinci secde:"
          }
        }
      }
    },
