    "hlFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُطبَّق صيفًا ابتداءً من خط العرض 48° تقريبًا، مثل ألمانيا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "গ্রীষ্মে প্রায় 48° অক্ষাংশ থেকে প্রযোজ্য, যেমন জার্মানিতে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Primjenjuje se ljeti od otprilike 48° geografske širine, npr. u Njemačkoj."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt im Sommer ab etwa 48° Breite, z. B. in Deutschland."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies from about 48° latitude in summer, e.g. Germany."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica en verano a partir de unos 48° de latitud, p. ej. en Alemania."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "در تابستان از حدود عرض 48° به بالا اعمال می‌شود، مثلاً در آلمان."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
