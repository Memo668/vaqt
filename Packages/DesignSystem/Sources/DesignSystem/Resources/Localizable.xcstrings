    },
    "alarmFixedFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يبقى الوقت الثابت كما هو، أما الشروق فيتغيّر على مدار السنة. يتبعه خيار «قبل الشروق» كل يوم؛ ويرنّ الوقت الثابت 5 دقائق على الأقل قبل الشروق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "নির্দিষ্ট সময় একই থাকে, অথচ সূর্যোদয়ের সময় সারা বছর বদলায়। “সূর্যোদয়ের আগে” প্রতিদিন তার সঙ্গে মিলিয়ে চলে; নির্দিষ্ট সময়ের অ্যালার্ম সূর্যোদয়ের অন্তত 5 মিনিট আগে বাজে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fiksno vrijeme ostaje isto, dok se izlazak sunca tokom godine pomjera. „Prije izlaska sunca“ ga prati svaki dan; fiksno vrijeme zvoni najkasnije 5 minuta prije izlaska sunca."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine feste Uhrzeit bleibt gleich, der Sonnenaufgang wandert übers Jahr. „Vor Sonnenaufgang“ folgt ihm jeden Tag; eine feste Uhrzeit klingelt spätestens 5 Minuten vor Sonnenaufgang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fixed time stays the same while sunrise moves through the year. “Before Sunrise” follows it every day; a fixed time rings no later than 5 minutes before sunrise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una hora fija no cambia, mientras que el amanecer varía a lo largo del año. “Antes del amanecer” lo sigue cada día; una hora fija suena como muy tarde 5 minutos antes del amanecer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ساعت ثابت تغییر نمی‌کند، اما طلوع آفتاب در طول سال جابه‌جا می‌شود. «پیش از طلوع آفتاب» هر روز با آن تنظیم می‌شود؛ ساعت ثابت دست‌کم 5 دقیقه پیش از طلوع آفتاب زنگ می‌زند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une heure fixe ne change pas, alors que le lever du soleil varie au fil de l’année. « Avant le lever du soleil » le suit chaque jour ; une heure fixe sonne au plus tard 5 minutes avant le lever du soleil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu tetap tidak berubah, sedangkan waktu matahari terbit bergeser sepanjang tahun. “Sebelum Matahari Terbit” mengikutinya setiap hari; waktu tetap berbunyi paling lambat 5 menit sebelum matahari terbit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un orario fisso resta uguale, mentre l’alba si sposta nel corso dell’anno. “Prima dell’alba” la segue ogni giorno; un orario fisso suona al più tardi 5 minuti prima dell’alba."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masa tetap tidak berubah, manakala waktu syuruk beralih sepanjang tahun. “Sebelum Syuruk” mengikutinya setiap hari; masa tetap berbunyi selewat-lewatnya 5 minit sebelum syuruk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een vaste tijd blijft gelijk, terwijl de zonsopgang door het jaar verschuift. ‘Vóór zonsopgang’ volgt die elke dag; een vaste tijd gaat uiterlijk 5 minuten vóór zonsopgang af."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Фиксированное время не меняется, а восход в течение года смещается. «До восхода» следует за ним каждый день; при фиксированном времени будильник звонит не позже чем за 5 минут до восхода."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ora fikse mbetet e njëjtë, ndërsa lindja e diellit zhvendoset gjatë vitit. „Para lindjes së diellit“ e ndjek çdo ditë; ora fikse bie jo më vonë se 5 minuta para lindjes së diellit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabit saat değişmez, güneşin doğuşu ise yıl boyunca değişir. „Güneş doğmadan önce“ her gün ona göre ayarlanır; sabit saat en geç güneş doğmadan 5 dakika önce çalar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مقررہ وقت ایک جیسا رہتا ہے، جبکہ طلوعِ آفتاب کا وقت سال بھر بدلتا رہتا ہے۔ “طلوعِ آفتاب سے پہلے” ہر روز اس کے ساتھ بدلتا ہے؛ مقررہ وقت والا الارم طلوعِ آفتاب سے کم از کم 5 منٹ پہلے بجتا ہے۔"
          }
        }
      }
    },
    "alarmFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يرنّ المنبّه كل يوم، حتى في الوضع الصامت وعند تفعيل التركيز – مثل منبّه iOS."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অ্যালার্ম প্রতিদিন বাজে, নীরব মোডে এবং ফোকাস চালু থাকলেও – iOS-এর অ্যালার্মের মতোই।"
