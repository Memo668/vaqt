    "styleColorFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يسري على التطبيق والأدوات والنشاط المباشر. مع البرتقالي والذهبي والرملي تظهر أوقات الكراهة بالبنفسجي بدل البرتقالي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অ্যাপ, উইজেট ও লাইভ অ্যাক্টিভিটিতে প্রযোজ্য। কমলা, সোনালি ও বালি রঙে মাকরুহ সময় কমলার বদলে বেগুনি দেখায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Važi za aplikaciju, widgete i Aktivnost uživo. Kod narandžaste, zlatne i pješčane boje mekruh vakti su ljubičasti, a ne narandžasti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für die App, die Widgets und die Live-Aktivität. Bei Orange, Gold und Sand sind die Verbotszeiten violett statt orange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the app, the widgets and the Live Activity. With Orange, Gold and Sand, makruh times are shown in violet instead of orange."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a la app, los widgets y la Actividad en directo. Con Naranja, Oro y Arena, los tiempos makruh se muestran en violeta en lugar de naranja."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای برنامه، ابزارک‌ها و فعالیت زنده اعمال می‌شود. با نارنجی، طلایی و شنی، اوقات مکروه به‌جای نارنجی، بنفش نشان داده می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S’applique à l’app, aux widgets et à l’Activité en direct. Avec Orange, Or et Sable, les heures makrouh sont en violet au lieu d’orange."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Berlaku untuk app, widget, dan Aktivitas Langsung. Pada Oranye, Emas, dan Pasir, waktu makruh berwarna ungu, bukan oranye."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vale per l’app, i widget e l’Attività in tempo reale. Con Arancione, Oro e Sabbia, i momenti makruh sono viola anziché arancioni."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Terpakai pada app, widget dan Aktiviti Langsung. Bagi Oren, Emas dan Pasir, waktu makruh berwarna ungu, bukan oren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geldt voor de app, de widgets en de Live-activiteit. Bij Oranje, Goud en Zand zijn de makroeh-tijden violet in plaats van oranje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Действует для приложения, виджетов и Live Activity. При оранжевом, золотом и песочном цвете время макрух отмечается фиолетовым, а не оранжевым."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vlen për aplikacionin, widget-et dhe Aktivitetin live. Me ngjyrat portokalli, ari dhe rërë, kohët mekruh janë vjollcë në vend të portokalli."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, widget’lar ve Canlı Etkinlik için geçerlidir. Turuncu, altın ve kum renginde kerahat vakitleri turuncu yerine mor gösterilir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ایپ، وجیٹس اور لائیو ایکٹیویٹی پر لاگو ہوتا ہے۔ نارنجی، سنہری اور ریتیلے رنگ میں مکروہ اوقات نارنجی کے بجائے بنفشی ہوتے ہیں۔"
          }
        }
      }
    },
    "styleIconFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتغيّر الأيقونة في الشاشة الرئيسية عندما تغادر هذه الصفحة. ويؤكّد iOS كل تغيير بإشعار."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই পৃষ্ঠা ছেড়ে গেলে হোম স্ক্রিনের আইকন বদলে যায়। iOS প্রতিটি পরিবর্তন একটি বার্তায় নিশ্চিত করে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ikona na početnom ekranu mijenja se kada napustite ovu stranicu. iOS potvrđuje svaku promjenu obavještenjem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Icon auf dem Home-Bildschirm wechselt, wenn du diese Seite verlässt. iOS bestätigt jeden Wechsel mit einem Hinweis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The icon on the Home Screen changes when you leave this page. iOS confirms each change with a notice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El icono de la pantalla de inicio cambia cuando sales de esta página. iOS confirma cada cambio con un aviso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نماد روی صفحهٔ اصلی وقتی این صفحه را ترک کنید عوض می‌شود. iOS هر تغییر را با یک پیام تأیید می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’icône sur l’écran d’accueil change lorsque vous quittez cette page. iOS confirme chaque changement par un message."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ikon di Layar Utama berubah saat Anda meninggalkan halaman ini. iOS mengonfirmasi setiap perubahan dengan pemberitahuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’icona nella schermata Home cambia quando esci da questa pagina. iOS conferma ogni modifica con un avviso."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ikon di Skrin Utama berubah apabila anda meninggalkan halaman ini. iOS mengesahkan setiap perubahan dengan pemberitahuan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het symbool op het beginscherm verandert wanneer je deze pagina verlaat. iOS bevestigt elke wijziging met een melding."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Значок на экране «Домой» меняется, когда вы покидаете эту страницу. iOS подтверждает каждое изменение уведомлением."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ikona në ekranin bazë ndryshon kur dilni nga kjo faqe. iOS e konfirmon çdo ndryshim me një njoftim."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana ekrandaki simge, bu sayfadan çıktığında değişir. iOS her değişikliği bir uyarıyla onaylar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ہوم اسکرین پر آئیکن اس وقت بدلتا ہے جب آپ یہ صفحہ چھوڑتے ہیں۔ iOS ہر تبدیلی کی تصدیق ایک پیغام سے کرتا ہے۔"
          }
        }
      }
