            "value" : "يُستخدم موقعك على هذا الجهاز فقط لحساب مواقيت الصلاة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার অবস্থান শুধু এই ডিভাইসে নামাজের সময় হিসাব করতে ব্যবহার করা হয়।"
