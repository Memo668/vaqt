{
  "sourceLanguage" : "de",
  "strings" : {
    "NSAlarmKitUsageDescription" : {
      "comment" : "Aus `T.alAlarmBody` im Prototyp.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ليرنّ منبّه الفجر حتى في الوضع الصامت وعند تفعيل التركيز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "যাতে ফজরের অ্যালার্ম নীরব মোডে এবং ফোকাস চালু থাকলেও বাজে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da bi alarm za sabah zvonio i u nečujnom načinu rada i kada je uključen fokus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit der Wecker zu Fadschr auch im Stummmodus und bei Fokus klingelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So the Fajr alarm rings even in silent mode and with a Focus on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que la alarma de Fajr suene incluso en modo silencio y con un modo de concentración activado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تا زنگ هشدار صبح حتی در حالت بی‌صدا و با تمرکز روشن به صدا درآید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour que l’alarme du Fajr sonne même en mode silencieux et avec un mode de concentration activé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Agar Alarm Subuh tetap berbunyi dalam mode senyap dan saat Fokus aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perché la sveglia per Fajr suoni anche in modalità silenziosa e con una modalità Full immersion attiva."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supaya Penggera Subuh tetap berbunyi dalam mod senyap dan ketika Fokus aktif."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zodat de wekker voor Fajr ook in de stille modus en met een focus aan afgaat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Чтобы будильник на Фаджр звонил даже в бесшумном режиме и при включённом фокусировании."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Që alarmi i sabahut të bjerë edhe në modalitetin e heshtur dhe kur Fokusi është aktiv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabah namazı alarmı sessiz modda ve odak açıkken de çalsın diye."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تاکہ فجر کا الارم خاموش موڈ میں اور فوکس آن ہونے پر بھی بجے۔"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Aus `T.alLocBody` im Prototyp.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُستخدم موقعك فقط لحساب مواقيت الصلاة. ولمعرفة اسم المكان، يستعلم التطبيق من خرائط Apple."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার অবস্থান শুধু নামাজের সময় হিসাব করতে ব্যবহার করা হয়। জায়গার নামের জন্য অ্যাপটি Apple Maps-এর কাছে জানতে চায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaša lokacija koristi se samo za izračunavanje namaskih vakata. Za naziv mjesta aplikacija pita Apple Karte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort dient nur der Berechnung der Gebetszeiten. Für den Ortsnamen fragt die App Apple Karten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is only used to calculate prayer times. For the place name, the app asks Apple Maps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación solo se usa para calcular los horarios de oración. Para el nombre del lugar, la app consulta Mapas de Apple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "موقعیت شما فقط برای محاسبه اوقات نماز استفاده می‌شود. برای نام مکان، برنامه از Apple Maps می‌پرسد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre position sert uniquement à calculer les heures de prière. Pour le nom du lieu, l’app interroge Plans d’Apple."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lokasi Anda hanya digunakan untuk menghitung jadwal salat. Untuk nama tempat, app ini bertanya kepada Peta Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La tua posizione viene usata solo per calcolare gli orari di preghiera. Per il nome del luogo, l’app si rivolge a Mappe di Apple."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lokasi anda hanya digunakan untuk mengira waktu solat. Untuk nama tempat, app ini bertanya kepada Peta Apple."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je locatie wordt alleen gebruikt om de gebedstijden te berekenen. Voor de plaatsnaam raadpleegt de app Apple Kaarten."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваша геопозиция используется только для расчёта времени намаза. За названием места приложение обращается к Apple Картам."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vendndodhja juaj përdoret vetëm për të llogaritur vaktet e namazit. Për emrin e vendit, aplikacioni pyet Hartat e Apple."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumun yalnızca namaz vakitlerini hesaplamak için kullanılır. Yer adı için uygulama Apple Haritalar’a sorar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "آپ کا مقام صرف اوقاتِ نماز کا حساب لگانے کے لیے استعمال ہوتا ہے۔ جگہ کے نام کے لیے ایپ Apple Maps سے پوچھتی ہے۔"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
