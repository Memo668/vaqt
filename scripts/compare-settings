#!/bin/bash
# Abgleich der Einstellungen, des Onboardings und des Adhan-Sheets mit den Referenzbildern
# design/screenshots/iphone/01–03, 05, 70, 73–83 und 86 (Phase 7; 05, 82, 83 seit Phase 12).
#
# Startet die App in jedem Zustand mit den Debug-Argumenten (-debugTab settings|method|…|privacy|adhan,
# -debugOnboarding 1|2|3), nimmt den Bildschirm auf und legt Ausschnitte mit scripts/compare-shot neben
# die Referenz. Die App muss gebaut und installiert sein:
#
#   make run
#   scripts/compare-settings              alle Zustände
#   scripts/compare-settings 70 86        nur diese
#
# iphone/71 und 72 sind die Einstellungen in der Mitte und ganz unten; das kann simctl nicht scrollen.
# Liegen die Aufnahmen schon in screenshots-out/phase-7/ – settings-71.png und settings-72.png,
# aufgenommen mit dem UI-Hilfsprojekt (Skript scripts/ui-harness/scripts/iphone-71-72-settings.txt,
# OUT gleich) –, vergleicht das Skript sie mit.
#
# Ergebnis in screenshots-out/phase-7/: <zustand>.png (Aufnahmen) und compare-<Ausschnitt>.png (oben
# Referenz, Mitte Aufnahme, unten Unterschied).
#
# Der Simulator (iPhone 18 Pro, 402 × 874 pt) ist 12 pt breiter und 30 pt höher als die Referenzbilder
# (390 × 844 pt). Verglichen werden deshalb Ausschnitte; Gruppen und Karten in zwei Hälften, jede an
# ihrem Rand ausgerichtet. Die Lage in der Höhe folgt den Leisten des Systems:
#   - Startseite (70): Der große Titel des Systems sitzt tiefer als im Prototyp; alles darunter 21,7 pt.
#   - Unterseiten (74–80): Die Leiste des Systems ist 54 statt 44 pt hoch und beginnt bei 62 statt 54 pt;
#     die erste Gruppe liegt 17 pt tiefer.
#   - Methode (73): Das Suchfeld des Systems ist 44 statt 38 pt hoch; die Gruppen liegen 13,3 pt tiefer.
#   - Datenschutz (81): 17 pt tiefer wie die Unterseiten.
#   - Adhan (86): Das Sheet beginnt tiefer; die Karte liegt 12 pt tiefer.
#   - Onboarding (01–03): Die Seite steht mittig im höheren Bildschirm, 18 bis 19 pt tiefer; die Knöpfe
#     stehen am unteren Rand, 29 pt tiefer.
#
# Der Simulator lässt sich mit SIM='…' wählen, wie im Makefile.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SIM="${SIM:-iPhone 18 Pro}"
BUNDLE_ID="${BUNDLE_ID:-$("$ROOT/scripts/bundle-id")}"
REF="$ROOT/design/screenshots/iphone"
OUT="${OUT:-$ROOT/screenshots-out/phase-7}"
ZOOM="${ZOOM:-3}"
WAIT="${WAIT:-2.5}"
STATES=("$@")

# compare Name Referenzbild Referenz-Ausschnitt Aufnahme Aufnahme-Ausschnitt
compare() {
  printf '  %-16s ' "$1"
  "$ROOT/scripts/compare-shot" --ref "$REF/$2.png" --ref-rect "$3" --shot "$4" --shot-rect "$5" \
    --out "$OUT/compare-$1.png" --zoom "$ZOOM" | head -1
}

# halves Name Referenzbild Aufnahme y-Referenz y-Aufnahme Höhe – linke und rechte Hälfte einer Gruppe
halves() {
  compare "$1-l" "$2" "0,$4,230,$6" "$3" "0,$5,230,$6"
  compare "$1-r" "$2" "160,$4,230,$6" "$3" "172,$5,230,$6"
}

# launch Aufnahme Argumente …
launch() {
  local shot="$1"
  shift
  xcrun simctl launch --terminate-running-process "$SIM" "$BUNDLE_ID" \
    -AppleLanguages '(de)' -AppleLocale de_DE "$@" >/dev/null
  sleep "$WAIT"
  xcrun simctl io "$SIM" screenshot "$shot" >/dev/null 2>&1
}

wanted() {
  [ ${#STATES[@]} -eq 0 ] && return 0
  local state
  for state in "${STATES[@]}"; do [ "$state" = "$1" ] && return 0; done
  return 1
}

mkdir -p "$OUT"
xcrun simctl bootstatus "$SIM" -b >/dev/null
xcrun simctl ui "$SIM" appearance light
xcrun simctl ui "$SIM" content_size large
# Der erste Start nach einer Pause dauert länger als die Wartezeit vor der Aufnahme. Deshalb einmal vorab.
xcrun simctl launch --terminate-running-process "$SIM" "$BUNDLE_ID" -debugSkipOnboarding -debugFixtureTimes >/dev/null
sleep 3

STATE=(-debugSkipOnboarding -debugFixtureTimes -debugDate 2026-11-10 -debugTime 14:25)

if wanted 70; then
  launch "$OUT/settings-70.png" "${STATE[@]}" -debugTab settings
  echo "iphone/70 (Einstellungen):"
  # Standort: Kopf bis Fußzeile 150 bis 300 pt; Berechnung 330 bis 590 pt.
  halves location-70 70-settings "$OUT/settings-70.png" 150 171.7 150
  halves calc-70 70-settings "$OUT/settings-70.png" 330 351.7 260
fi

if [ -f "$OUT/settings-71.png" ] && wanted 71; then
  echo "iphone/71 (Aufnahme des UI-Hilfsprojekts):"
  # Mitteilungen ab 115 pt, Darstellung mit Fußzeile bis 630 pt (App: Gruppe ab 133 pt).
  halves notif-71 71-settings-middle "$OUT/settings-71.png" 115 133 520
fi

if [ -f "$OUT/settings-72.png" ] && wanted 72; then
  echo "iphone/72 (Aufnahme des UI-Hilfsprojekts):"
  # Über, Hinweis und Tagline, ab dem Kopf „Über“ (Referenz 410 pt, App 459,3 pt: ganz unten, der Bildschirm ist höher).
  halves about-72 72-settings-bottom "$OUT/settings-72.png" 410 459.3 330
fi

if wanted 73; then
  launch "$OUT/settings-73.png" "${STATE[@]}" -debugTab method
  echo "iphone/73 (Berechnungsmethode):"
  halves method-73 73-settings-method "$OUT/settings-73.png" 160 173.3 420
fi

subpage() {
  local nr="$1" page="$2" name="$3" height="$4"
  wanted "$nr" || return 0
  launch "$OUT/settings-$nr.png" "${STATE[@]}" -debugTab "$page"
  echo "iphone/$nr ($page):"
  halves "$page-$nr" "$name" "$OUT/settings-$nr.png" 105 122 "$height"
}
subpage 74 asr 74-settings-asr 140
subpage 75 hl 75-settings-hl 290
subpage 76 adjust 76-settings-adjust 410
subpage 77 perPrayer 77-settings-perprayer 380
subpage 78 reminder 78-settings-reminder 270
subpage 79 live 79-settings-live 200
subpage 80 sound 80-settings-sound 260
subpage 83 support 83-settings-support 560

if [ -f "$OUT/settings-82.png" ] && wanted 82; then
  echo "iphone/82 (Aufnahme des UI-Hilfsprojekts):"
  # Hohe Breitengrade mit „Manuelle Winkel“: Regeln und die Gruppe „Dämmerungswinkel“ (Spec § 9.12).
  halves hl-82 82-settings-hl-manual "$OUT/settings-82.png" 105 122 420
fi

if wanted 81; then
  launch "$OUT/settings-81.png" "${STATE[@]}" -debugTab privacy
  echo "iphone/81 (Datenschutz):"
  compare privacy-81 81-settings-privacy "0,105,390,380" "$OUT/settings-81.png" "6,122,390,380"
fi

if wanted 86; then
  launch "$OUT/adhan-86.png" "${STATE[@]}" -debugTab adhan
  echo "iphone/86 (Adhan):"
  halves card-86 86-sheet-adhan "$OUT/adhan-86.png" 128 140 326
  # Seit Phase 18 steht unter der Karte nur noch die Fußnote zur Aufnahme (Spec § 11.2).
  halves foot-86 86-sheet-adhan "$OUT/adhan-86.png" 454 466 60
fi

# onboarding Nummer Schritt Referenzbild Lage-y – seit dem Nachtrag zu Phase 18 fünf Schritte (Spec § 11.5):
# 01 Willkommen, 02 Standort, 03 Rechtsschule, 05 Mitteilungen (Schritt 4), 06 „Kostenlos“ (Schritt 5).
onboarding() {
  local nr="$1" step="$2" name="$3" shift_y="$4"
  wanted "$nr" || return 0
  launch "$OUT/onboarding-$nr.png" -debugFixtureTimes -debugDate 2026-11-10 -debugTime 09:10 -debugOnboarding "$step"
  echo "iphone/$nr (Onboarding, Schritt $step):"
  compare "page-$nr" "$name" "0,200,390,340" "$OUT/onboarding-$nr.png" "6,$shift_y,390,340"
  compare "actions-$nr" "$name" "0,700,390,144" "$OUT/onboarding-$nr.png" "6,729,390,144"
  compare "skip-$nr" "$name" "190,54,200,44" "$OUT/onboarding-$nr.png" "202,62,200,44"
}
onboarding 01 1 01-onboarding-1-welcome 218.6
onboarding 02 2 02-onboarding-2-location 218
onboarding 03 3 03-onboarding-3-madhab 218
onboarding 05 4 05-onboarding-4-notifications 218

# Schritt 5 „Kostenlos. Ohne Werbung.“ (Spec § 9.9).
if wanted 06; then
  launch "$OUT/onboarding-06.png" -debugFixtureTimes -debugDate 2026-11-10 -debugTime 09:10 -debugOnboarding 5
  echo "iphone/06 (Onboarding, Schritt 5):"
  compare "page-06" 06-onboarding-5-free "0,140,390,360" "$OUT/onboarding-06.png" "6,158,390,360"
  compare "actions-06" 06-onboarding-5-free "0,700,390,144" "$OUT/onboarding-06.png" "6,729,390,144"
fi

# Nachtrag zu Phase 18: Klang mit Systemton (§ 11.3), Rechtsschule (§ 11.6), Stil (§ 11.7).
if wanted 80s; then
  launch "$OUT/settings-80s.png" "${STATE[@]}" -debugTab sound -debugSound system
  echo "iphone/80-settings-sound-system (Klang, Systemton):"
  halves sound-80s 80-settings-sound-system "$OUT/settings-80s.png" 105 122 300
fi
subpage 88 madhab 88-settings-madhab 520
if wanted 87; then
  launch "$OUT/settings-87.png" "${STATE[@]}" -debugTab style
  echo "iphone/87 (Stil):"
  compare preview-87 87-settings-style "0,105,390,190" "$OUT/settings-87.png" "6,122,390,190"
  halves colors-87 87-settings-style "$OUT/settings-87.png" 295 312 200
  halves live-87 87-settings-style "$OUT/settings-87.png" 495 512 270
fi
if wanted 87o; then
  launch "$OUT/settings-87o.png" "${STATE[@]}" -debugTab style -debugAccent orange -debugLiveStyle arc -debugLiveInverted
  echo "iphone/87-settings-style-open (Stil, Orange, Nur Bogen invertiert):"
  compare preview-87o 87-settings-style-open "0,105,390,190" "$OUT/settings-87o.png" "6,122,390,190"
  halves colors-87o 87-settings-style-open "$OUT/settings-87o.png" 295 312 380
fi

echo "Ergebnis in $OUT"
