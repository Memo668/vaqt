#!/usr/bin/env python3
"""Bildsatz `AppMark` aus den Icon-Composer-Dateien der App (Phase 20, Spec § 9.1 und § 13).

SwiftUI kann das App-Icon nicht als Bild laden. Deshalb liegt es als Bildsatz im Paket DesignSystem: je Grundfarbe
hell (Standard) und dunkel, 360 × 360 px, gerendert von `ictool` aus Icon Composer (Xcode) in der Darstellung von iOS 27
und als 8-Bit-PNG gespeichert (ictool schreibt 16 Bit, das wäre etwa viermal so groß).

  Quelle                                        Ziel (Packages/DesignSystem/Sources/DesignSystem/Resources/Brand.xcassets/)
  App/AppIcon.icon                    (Petrol)  AppMark.imageset/AppMark.png, AppMark-dark.png
  App/AlternateIcons/AppIcon-<id>.icon          AppMark-<id>.imageset/AppMark-<id>.png, AppMark-<id>-dark.png

<id> wie `AccentColorID` (PrayerCore). Aufruf:

  scripts/app-mark                 alle 24 Grundfarben neu rendern
  scripts/app-mark teal green      nur diese
  scripts/app-mark --check         ohne ictool prüfen: zu jeder Grundfarbe ein Icon und ein Bildsatz mit beiden Bildern,
                                   und project.yml nennt die 23 alternativen Icons (make check-icons, vor make test)

ictool rendert nicht ganz bitgleich; zwei Läufe ergeben deshalb nicht immer dieselben Dateien.
"""
import json
import pathlib
import re
import struct
import subprocess
import sys
import tempfile
import zlib

ROOT = pathlib.Path(__file__).resolve().parent.parent
STYLE = ROOT / 'Packages/PrayerCore/Sources/PrayerCore/Model/AppStyle.swift'
ASSETS = ROOT / 'Packages/DesignSystem/Sources/DesignSystem/Resources/Brand.xcassets'
SIDE = 360                 # 120 pt im Onboarding mit dreifacher Auflösung
GENERATION = '27'          # Darstellung von iOS 27; iOS 26 rendert etwas flacher
STANDARD = 'teal'          # Petrol: das Haupt-Icon AppIcon und der Bildsatz AppMark


def accents():
    """Die Grundfarben in der Reihenfolge von `AccentColorID`."""
    body = re.search(r'enum AccentColorID[^{]*\{(.*?)\n    /// ', STYLE.read_text(), re.S)
    ids = re.findall(r'\b(\w+)\b', ' '.join(re.findall(r'^\s*case ([\w, ]+)$', body.group(1), re.M))) if body else []
    if len(ids) != 24 or ids[0] != STANDARD:
        sys.exit(f'app-mark: AccentColorID in {STYLE.relative_to(ROOT)} nicht gefunden ({len(ids)} Farben)')
    return ids


def icon_path(accent):
    return ROOT / ('App/AppIcon.icon' if accent == STANDARD else f'App/AlternateIcons/AppIcon-{accent}.icon')


def image_name(accent):
    return 'AppMark' if accent == STANDARD else f'AppMark-{accent}'


def contents(name):
    return {
        'images': [
            {'filename': f'{name}.png', 'idiom': 'universal'},
            {'appearances': [{'appearance': 'luminosity', 'value': 'dark'}], 'filename': f'{name}-dark.png', 'idiom': 'universal'},
        ],
        'info': {'author': 'xcode', 'version': 1},
    }


def png_size(path):
    data = path.read_bytes()
    if data[:8] != b'\x89PNG\r\n\x1a\n' or data[12:16] != b'IHDR':
        return None
    return struct.unpack('>II', data[16:24])


def png_8bit(data):
    """RGBA mit 16 oder 8 Bit (wie ictool es schreibt) als RGBA mit 8 Bit und Paeth-Filter."""
    i, idat, hdr = 8, [], None
    while i < len(data):
        n = struct.unpack('>I', data[i:i + 4])[0]
        if data[i + 4:i + 8] == b'IHDR':
            hdr = struct.unpack('>IIBBBBB', data[i + 8:i + 8 + n])
        elif data[i + 4:i + 8] == b'IDAT':
            idat.append(data[i + 8:i + 8 + n])
        i += 12 + n
    w, h, depth, ctype, _, _, interlace = hdr
    if ctype != 6 or interlace or depth not in (8, 16):
        sys.exit('app-mark: unerwartetes PNG von ictool')
    bpp = 8 if depth == 16 else 4
    raw, stride, prev, pos, out, prev8 = zlib.decompress(b''.join(idat)), w * bpp, bytearray(w * bpp), 0, bytearray(), bytearray(w * 4)
    for _ in range(h):
        ft, cur = raw[pos], bytearray(raw[pos + 1:pos + 1 + stride])
        pos += 1 + stride
        for x in range(stride):
            a = cur[x - bpp] if x >= bpp else 0
            b = prev[x]
            c = prev[x - bpp] if x >= bpp else 0
            if ft == 1:
                cur[x] = (cur[x] + a) & 255
            elif ft == 2:
                cur[x] = (cur[x] + b) & 255
            elif ft == 3:
                cur[x] = (cur[x] + ((a + b) >> 1)) & 255
            elif ft == 4:
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                cur[x] = (cur[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        prev = cur
        row = bytearray(cur[0::2]) if depth == 16 else cur
        filt = bytearray(len(row))
        for x in range(len(row)):
            a = row[x - 4] if x >= 4 else 0
            b = prev8[x]
            c = prev8[x - 4] if x >= 4 else 0
            p = a + b - c
            pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
            filt[x] = (row[x] - (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        out += b'\x04' + filt
        prev8 = row

    def chunk(kind, body):
        return struct.pack('>I', len(body)) + kind + body + struct.pack('>I', zlib.crc32(kind + body) & 0xFFFFFFFF)
    return (b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 6, 0, 0, 0))
            + chunk(b'IDAT', zlib.compress(bytes(out), 9)) + chunk(b'IEND', b''))


def find_ictool():
    try:
        dev = subprocess.run(['xcode-select', '-p'], check=True, capture_output=True, text=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        dev = '/Applications/Xcode.app/Contents/Developer'
    tool = pathlib.Path(dev).parent / 'Applications/Icon Composer.app/Contents/Executables/ictool'
    if not tool.exists():
        sys.exit(f'app-mark: ictool nicht gefunden ({tool}) – es gehört zu Icon Composer in Xcode')
    return tool


def render(tool, accent, tmp):
    name, folder = image_name(accent), ASSETS / f'{image_name(accent)}.imageset'
    folder.mkdir(exist_ok=True)
    for rendition, suffix in (('Default', ''), ('Dark', '-dark')):
        png = pathlib.Path(tmp) / f'{name}{suffix}.png'
        cmd = [str(tool), str(icon_path(accent)), '--export-image', '--output-file', str(png), '--platform', 'iOS',
               '--rendition', rendition, '--width', str(SIDE), '--height', str(SIDE), '--scale', '1', '--design-generation', GENERATION]
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode or not png.exists():
            sys.exit(f'app-mark: ictool {icon_path(accent).name} {rendition}: {res.stderr[-300:]}')
        (folder / f'{name}{suffix}.png').write_bytes(png_8bit(png.read_bytes()))
    (folder / 'Contents.json').write_text(json.dumps(contents(name), indent=2, separators=(',', ' : ')) + '\n')
    size = sum(f.stat().st_size for f in folder.glob('*.png'))
    print(f'{folder.relative_to(ROOT)}  {size // 1024} KB')


def check(ids):
    problems = []
    for accent in ids:
        if not (icon_path(accent) / 'icon.json').exists():
            problems.append(f'Icon fehlt: {icon_path(accent).relative_to(ROOT)}')
        name = image_name(accent)
        folder = ASSETS / f'{name}.imageset'
        for suffix in ('', '-dark'):
            png = folder / f'{name}{suffix}.png'
            if not png.exists():
                problems.append(f'Bild fehlt: {png.relative_to(ROOT)}')
            elif png_size(png) != (SIDE, SIDE):
                problems.append(f'{png.relative_to(ROOT)} ist {png_size(png)} statt {SIDE} × {SIDE}')
        if (folder / 'Contents.json').exists() and json.loads((folder / 'Contents.json').read_text()) != contents(name):
            problems.append(f'{folder.relative_to(ROOT)}/Contents.json weicht ab')
    listed = re.search(r'ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES: >-\n((?:\s+AppIcon-[\w -]+\n)+)', (ROOT / 'project.yml').read_text())
    expected = [f'AppIcon-{a}' for a in ids if a != STANDARD]
    if not listed or listed.group(1).split() != expected:
        problems.append('project.yml: ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES nennt nicht die 23 Icons in der Reihenfolge von AccentColorID')
    known = {f'{image_name(a)}.imageset' for a in ids}
    extra = sorted(p.name for p in ASSETS.glob('AppMark*.imageset') if p.name not in known)
    extra += sorted(p.name for p in (ROOT / 'App/AlternateIcons').glob('*.icon') if p.stem.removeprefix('AppIcon-') not in ids)
    problems += [f'überzählig: {name}' for name in extra]
    for line in problems:
        print(f'app-mark: {line}', file=sys.stderr)
    if problems:
        sys.exit(1)
    print(f'app-mark: {len(ids)} Grundfarben, je Icon und Bildsatz hell und dunkel ({SIDE} px)')


def main():
    ids, args = accents(), sys.argv[1:]
    if args == ['--check']:
        return check(ids)
    unknown = [a for a in args if a not in ids]
    if unknown:
        sys.exit(f'app-mark: unbekannte Grundfarbe {", ".join(unknown)} (bekannt: {", ".join(ids)})')
    tool = find_ictool()
    with tempfile.TemporaryDirectory() as tmp:
        for accent in args or ids:
            render(tool, accent, tmp)
    if not args:
        check(ids)


if __name__ == '__main__':
    main()
