#!/bin/bash
# Erzeugt Localizable.xcstrings, L10n.swift und die Liste der Verse aus dem Prototyp (`T`, `VERSES`, `SURAH`).
#
#   scripts/import-strings            Dateien neu schreiben
#   scripts/import-strings --check    nur prüfen (Exit 1, wenn die Dateien nicht zum Prototyp passen)
#
# Einzelheiten stehen in scripts/import-strings.swift.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec swift "$ROOT/scripts/import-strings.swift" --root "$ROOT" "$@"
